<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.17">
  <POU Name="ManualMachine" Id="{01bc7f0f-8a11-4b18-bb7f-35e7e0af063e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ManualMachine
VAR														
	MyXts : Xts<2,1,4,1,1>('MyXts');
	initSequence : INT;
	DummyVar1: UDINT;
	DummyVar2: BOOL;
	DummyVar3: BOOL;
	DummyVar8: BOOL;
	DummyVar6: BOOL;
	DummyVar4: BOOL;
	DummyVar5: BOOL;
	DummyVar7: BOOL;
	myMover : I_XtsMover;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{1681b264-7edf-4ae1-9044-9c4a2173eaf4}">
      <Declaration><![CDATA[METHOD Cycle : HRESULT
VAR
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[MyXts.Cycle();

DummyVar1 := MyXts.ErrorId;
DummyVar2 := MyXts.HardwareDiscoveryComplete;
DummyVar3 := MyXts.HasError;
DummyVar4 := MyXts.Initialised;
DummyVar5 := MyXts.IsEnabled;
DummyVar6 := MyXts.IsIdle;
DummyVar7 := MyXts.IsRunningInSim;
DummyVar8 := MyXts.MoversFound;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialise" Id="{6b8163d9-bce6-4337-9033-0358a8ecc516}">
      <Declaration><![CDATA[METHOD Initialise : BOOL
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE initSequence OF
	0:
		IF MyXts.HardwareDiscoveryComplete THEN
			initSequence := 1;
		END_IF
	1:
		IF SUCCEEDED(myxts.TriggerMoverDetection()) THEN
			initSequence := 2;
		END_IF
	2:
		IF SUCCEEDED(MyXts.TryGetXtsMover(Number := 1, Mover => myMover)) THEN
			initSequence := 3;
		END_IF
	3:
		Initialise := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestAMoveFromMover" Id="{327d02cb-bbd3-4551-844b-8d68ff55b11c}">
      <Declaration><![CDATA[METHOD RequestAMoveFromMover : BOOL
VAR_INPUT
// 	MoverNumber : INT;
// 	Position : LREAL;
// 	Velocity : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Movers[MoverNumber].MoveTo(Position, Velocity, TRUE);
// RequestAMoveFromMover := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{395bc196-295d-428d-92a8-a410798a676c}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := SUCCEEDED(myxts.Reset());]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{02461f05-6499-4d09-bb40-4c0779bf05a4}">
      <Declaration><![CDATA[METHOD Start : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Start := SUCCEEDED( MyXts.EnableXTS());]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{fbb70648-c073-41fc-bad0-78d07ae8f95d}">
      <Declaration><![CDATA[METHOD Stop : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Stop := Succeeded( MyXts.DisableXTS());]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>