<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsEnableSequence" Id="{b7e7ab09-3a30-4ddb-a242-e0b5aa00cbc9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsEnableSequence  IMPLEMENTS I_MoverEnableAlgorithm
VAR
	moverIndex : UINT;
	AllMoversEnabled: BOOL;
	EnableTrigger : BOOL;	
	_MoverCount : UDINT;
	iMoverArray : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF I_XtsMover;
	iCAGroup : I_CollisionGroup;
	XtsName : T_MaxString;
	State: EnableState;
	_Done: BOOL;
	_Error: BOOL;
	_Busy: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[{analysis -2}]]></ST>
    </Implementation>
    <Method Name="Abort" Id="{9cec9788-9ce4-4a9f-821c-172bdb3141aa}">
      <Declaration><![CDATA[METHOD Abort : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[EnableTrigger := FALSE;
State := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{bc4497ef-9c3a-4d02-9785-8733db6c9845}">
      <Declaration><![CDATA[PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{d45d9021-7bdc-468f-89fe-ec603e3e38b0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cycle" Id="{2913b891-dfae-43d9-b9d3-4a1a1101f452}">
      <Declaration><![CDATA[METHOD Cycle : HRESULT
VAR
	i : UDINT;
	AddMoverString : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE State OF
	EnableState.Idle:
		IF EnableTrigger THEN
			Base_Library.Tracing.Trace.Info(XtsName, '- Enable Starting');
			Cycle := S_PENDING;
			State := EnableState.Reset_Movers;
			EnableTrigger := FALSE;
			moverIndex := 0;
			_Busy := TRUE;
			_Done := FALSE;
			_Error := FALSE;
		END_IF
		
	EnableState.Reset_Movers:
		Base_Library.Tracing.Trace.Verbose(XtsName, '- Resetting Movers');
		FOR i := 0 TO (_MoverCount - 1) DO
			iMoverArray[i].Reset();
		END_FOR
		State := EnableState.Reset_Group;
		
	EnableState.Reset_Group:
		IF iCAGroup.IsInErrorStop THEN
			Base_Library.Tracing.Trace.Verbose(XtsName, '- Resetting CAGroup');
			iCAGroup.Reset();
		END_IF
		State := EnableState.Add_Mover;
		
	EnableState.Add_Mover:
		IF Succeeded( icagroup.AddMoverToThisGroup(MoverToAdd := iMoverArray[moverIndex])) THEN
			AddMoverString := '';
			AddMoverString := CONCAT('- Mover ', TO_STRING(iMoverArray[moverIndex].AxisRef.NcToPlc.AxisId));
			Base_Library.Tracing.Trace.Verbose(XtsName, CONCAT(AddMoverString, ' Added To Group'));
			State := EnableState.Check_Add_Mover;
		ELSE
			AddMoverString := '';
			AddMoverString := CONCAT('- Mover ', TO_STRING(iMoverArray[moverIndex].AxisRef.NcToPlc.AxisId));
			Base_Library.Tracing.Trace.Error(XtsName, CONCAT(AddMoverString,'- Add Mover Failed'));
			State := EnableState.EnableSequenceError;
		END_IF
		
	EnableState.Check_Add_Mover:
		IF moverIndex <> (_MoverCount - 1) THEN
			moverIndex := moverIndex + 1;
			State := EnableState.Add_Mover;
		ELSE
			Base_Library.Tracing.Trace.Verbose(XtsName, '- Enabling Movers');
			FOR i := 0 TO (_MoverCount-1) DO
				iMoverArray[i].EnableMover();
			END_FOR
			State := EnableState.Enable_Movers;
		END_IF
		
	EnableState.Enable_Movers:
		AllMoversEnabled := TRUE;
		FOR i := 0 TO (_MoverCount - 1) DO
			AllMoversEnabled := TRUE AND iMoverArray[i].IsEnabled;
		END_FOR
		IF AllMoversEnabled THEN
			Base_Library.Tracing.Trace.Verbose(XtsName, '- Movers Enabled');
			State := EnableState.Enable_Group;
		END_IF
		IF EnableMoverTimeOut.Q THEN
			Base_Library.Tracing.Trace.Error(XtsName, '- Movers Havent Enabled');
			State := EnableState.EnableSequenceError;
		END_IF

	EnableState.Enable_Group:
		IF iCAGroup.Enable() THEN
			Base_Library.Tracing.Trace.Verbose(XtsName, '- CAGroup Enabled');
			State := EnableState.Check_Standby;
		END_IF
		
	EnableState.Check_Standby:
		IF iCAGroup.IsInStandBy THEN
			State := EnableState.Idle;
			_Busy := FALSE;
			_Done := TRUE;
			Cycle := S_OK;
			Base_Library.Tracing.Trace.Info(XtsName, '- Enable Complete');
		END_IF
		IF GroupEnableTimeOut.Q THEN
			Base_Library.Tracing.Trace.Error(XtsName, '- Group hasnt Enabled');
			State := EnableState.EnableSequenceError;
		END_IF
	EnableState.EnableSequenceError:
		Base_Library.Tracing.Trace.Error(Source := XtsName, Message := 'ENABLE FAILED - SYSTEM FAULT - RESTART REQUIRED');
		_Error := TRUE;
		_Busy := FALSE;
		EnableMoverTimeOut.IN := FALSE;
		GroupEnableTimeOut.IN := FALSE;
		State := EnableState.EnableSequenceFailed;
END_CASE

GroupEnableTimeOut();
EnableMoverTimeOut();]]></ST>
      </Implementation>
    </Method>
    <Property Name="Done" Id="{81ec7814-89cb-4301-940b-bd26fe7c0dd9}">
      <Declaration><![CDATA[PROPERTY Done : BOOL
]]></Declaration>
      <Get Name="Get" Id="{f5e4b06f-0267-4980-bd12-ca8f03d203a3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Done := _Done;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Enable" Id="{1c2a3468-bb52-4165-8d13-732b960a1dd0}">
      <Declaration><![CDATA[METHOD Enable : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MoverCount = 0 THEN
	Enable := -1;
	RETURN;
END_IF

IF _Busy THEN
	Enable := -2;
	RETURN;
END_IF

IF iCAGroup = 0 THEN
	Enable := -3;
	RETURN;
END_IF

EnableTrigger := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Error" Id="{de4172ae-7561-44d0-9211-14ccf56f7fba}">
      <Declaration><![CDATA[PROPERTY Error : BOOL
]]></Declaration>
      <Get Name="Get" Id="{7981ac0e-81ff-46ad-91e6-7e6c0cd85d62}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := _Error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Name" Id="{52cf67ff-b6ca-4762-b511-ef24ddd9e725}">
      <Declaration><![CDATA[PROPERTY Name : T_MAXSTRING]]></Declaration>
      <Get Name="Get" Id="{a2b7398c-3da2-452f-b1f5-87f6ef9c1ac9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{5f34baa4-89ce-45f4-8055-3eba61c3d13b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[XtsName := CONCAT(Name, ' Enable Sequence');]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Reset" Id="{18e03b81-5621-4d61-8dd4-9bb9bd5ee968}">
      <Declaration><![CDATA[METHOD Reset : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetComponents" Id="{0d002451-1421-4fb5-b1ba-e97af42ef1c7}">
      <Declaration><![CDATA[METHOD SetComponents : BOOL
VAR_INPUT
	MoverArray : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF I_XtsMover;
	CAGroup : I_CollisionGroup;
	MoverCount : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iMoverArray := MoverArray;
iCAGroup := CAGroup;
_MoverCount := MoverCount;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{b9d8eaad-637c-4dcb-a8aa-5298427739c9}">
      <Declaration><![CDATA[METHOD Reset : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>