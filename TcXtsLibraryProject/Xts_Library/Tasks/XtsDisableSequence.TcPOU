<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsDisableSequence" Id="{da9628bf-0fcc-432f-b10d-3ad4dd4b7f24}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsDisableSequence IMPLEMENTS I_MoverDisableAlgorithm
VAR
	DisableTrigger: BOOL;
	AllMoversDisabled: BOOL;	
	_MoverCount : UDINT;
	iMoverArray : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF I_XtsMover;
	iCAGroup : I_CollisionGroup;
	XtsName : T_MaxString;
	CaGroupResetResult: BOOL;
	State: DisableState;
	DisableMoverTimeOut : TON := (PT := DEFAULT_ADS_TIMEOUT);
	GroupRemoveAllTimeOut : TON := (PT := DEFAULT_ADS_TIMEOUT);
	_Done: BOOL;
	_Error: BOOL;
	_Busy: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[{analysis -2}]]></ST>
    </Implementation>
    <Method Name="Abort" Id="{86211cf7-3baa-4942-994c-481ee3b2466c}">
      <Declaration><![CDATA[METHOD Abort : HRESULT
VAR
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[DisableTrigger := FALSE;
State := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{31fee075-b465-44b4-a7dd-aab9d5d631b4}">
      <Declaration><![CDATA[PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{edcd40ed-55fa-45eb-9c70-bed5c284d98d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cycle" Id="{981b7190-eb15-4a0a-8875-0afb334ed36e}">
      <Declaration><![CDATA[METHOD Cycle : HRESULT
VAR
	i : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE State OF
	DisableState.Idle:
		IF DisableTrigger THEN
			Base_Library.Tracing.Trace.Info(XtsName, '- Disable Starting');
			Cycle := S_PENDING;
			DisableTrigger := FALSE;
			_Busy := TRUE;
			_Done := FALSE;
			_Error := FALSE;
			State := DisableState.Group_Stop;
		END_IF
		
	DisableState.Group_Stop:
		IF iCAGroup.IsMoving THEN
			Base_Library.Tracing.Trace.Verbose(XtsName, '- Group Stopping');
			iCAGroup.GroupStop();
		END_IF
		State := DisableState.Remove_Movers;
		
	DisableState.Remove_Movers:
		IF iCAGroup.IsInStandBy THEN
			Base_Library.Tracing.Trace.Verbose(XtsName, '- Removing Movers');
			IF SUCCEEDED(iCAGroup.RemoveAllMovers()) THEN
				State := DisableState.Disable_Movers;
			END_IF
		END_IF
	
	DisableState.Disable_Movers:
		IF iCAGroup.AxisCount = 0 THEN
			FOR i := 0 TO (_MoverCount - 1) DO
				iMoverArray[i].DisableMover();
			END_FOR
			Base_Library.Tracing.Trace.Verbose(XtsName, '- Disabling Movers');
			State := DisableState.Disable_Group;
		END_IF
		IF GroupRemoveAllTimeOut.Q THEN
			Base_Library.Tracing.Trace.Error(XtsName, '- Group Remove All Movers Error');
			State := DisableState.DisableSequenceError;
		END_IF
		
	DisableState.Disable_Group:
		AllMoversDisabled := TRUE;
		FOR i := 0 TO (_MoverCount - 1) DO
			AllMoversDisabled := AllMoversDisabled AND NOT iMoverArray[i].IsEnabled;
		END_FOR
		IF AllMoversDisabled THEN
			DisableMoverTimeOut.IN := FALSE;
			Base_Library.Tracing.Trace.Verbose(XtsName, '- Mover Disabled');
			State := DisableState.Reset_Group;
			iCAGroup.Disable();
		END_IF
		IF DisableMoverTimeOut.Q THEN
			Base_Library.Tracing.Trace.Error(XtsName, '- Movers Havent Disabled');
			State := DisableState.DisableSequenceError;
		END_IF
		
	DisableState.Reset_Group:
		IF iCAGroup.IsInErrorStop THEN
			iCAGroup.Reset();
		END_IF
		Base_Library.Tracing.Trace.Verbose(XtsName, '- Group Disabled');	
		State := DisableState.Wait_For_Disabled;
		
	DisableState.Wait_For_Disabled:
		IF iCAGroup.IsDisabled THEN
			State := DisableState.Idle;
			Cycle := S_OK;
			_Busy := FALSE;
			_Done := TRUE;
			Base_Library.Tracing.Trace.Info(XtsName, '- Disable Complete');
		END_IF
	DisableState.DisableSequenceError:
		Base_Library.Tracing.Trace.Error(Source := XtsName, Message := 'Disable FAILED - SYSTEM FAULT - RESTART REQUIRED');
		_Error := TRUE;
		_Busy := FALSE;
		DisableMoverTimeOut.IN := FALSE;
		GroupRemoveAllTimeOut.IN := FALSE;
		State := EnableState.EnableSequenceFailed;
END_CASE
DisableMoverTimeOut();
GroupRemoveAllTimeOut();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Disable" Id="{024bbd18-8e3c-4aa1-9d04-45454423df20}">
      <Declaration><![CDATA[METHOD Disable : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MoverCount = 0 THEN
	Disable := -1;
	RETURN;
END_IF

IF _busy THEN
	Disable := -2;
	RETURN;
END_IF

IF iCAGroup = 0 THEN
	Disable := -3;
	RETURN;
END_IF

DisableTrigger := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Done" Id="{440a0b71-7140-4d16-8dd2-a4a4081fd61d}">
      <Declaration><![CDATA[PROPERTY Done : BOOL
]]></Declaration>
      <Get Name="Get" Id="{e5bec694-8449-46b8-8efe-c1c6e77a0a8d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Done := _Done;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Error" Id="{6b8cc903-8899-4daa-98e1-e8890e9ccd7b}">
      <Declaration><![CDATA[PROPERTY Error : BOOL
]]></Declaration>
      <Get Name="Get" Id="{9fda5300-f4eb-497a-ab0f-244402c0a65e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := _Error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Name" Id="{d60ff4a1-1564-44eb-9e2d-604545979e85}">
      <Declaration><![CDATA[PROPERTY Name : T_MAXSTRING]]></Declaration>
      <Get Name="Get" Id="{9541a584-baad-4e29-8523-6265edae2bb6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{9cef1a8e-8d58-41fd-994c-725ecc629bcc}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[XtsName := CONCAT(Name, ' Disable Sequence');]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Reset" Id="{113baa4d-c467-43f5-96df-96216fb1bbbb}">
      <Declaration><![CDATA[METHOD Reset : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetComponents" Id="{373c9af2-fa4c-4375-bef9-d7f4ad023fc4}">
      <Declaration><![CDATA[METHOD SetComponents : BOOL
VAR_INPUT
	MoverArray : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF I_XtsMover;
	CAGroup : I_CollisionGroup;
	MoverCount : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iMoverArray := MoverArray;
iCAGroup := CAGroup;
_MoverCount := MoverCount;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{1832957b-67fd-4fd0-ba22-1e69838158ef}">
      <Declaration><![CDATA[METHOD Reset : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>