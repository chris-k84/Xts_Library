<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StandardMoverDetection" Id="{744247ae-04e1-4969-9309-29980f43d20b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK StandardMoverDetection IMPLEMENTS I_MoverDetectionAlgorithm
VAR
	iXtsTracks : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsTracksPerXpu] OF I_XtsTrack;
	iMoverArray : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF I_XtsMover;
	iXPU : I_TcIoXtsProcessingUnit;
	XtsName : T_MaxString;
	MoverDetectionState : XtsMoverDetectionState;
	StartFlag : BOOL;
	ResetFlag : BOOL;
	_DetectedMoverCount: UDINT;
	MoverIdDetectionState: MoverIdDetectionStateEnum;
	MoverIdDetectionError: BOOL;
	MoverIdDetected: BOOL;
	_busy : BOOL;
	_done : BOOL;
	_error : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Abort" Id="{26597c74-4029-447e-a786-072429fd8646}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Abort : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{7de3ebb0-a4b6-4ba8-a676-480469ee6c84}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{d94c0ad5-3b9d-4d0e-bb80-bdaaf09cfddb}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cycle" Id="{ca7e54fe-ab1d-4501-9422-498d01d08e54}">
      <Declaration><![CDATA[METHOD Cycle : Base_Library.HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE MoverDetectionState OF
	XtsMoverDetectionState.WaitingForCommandStart:
		IF StartFlag THEN
			StartFlag := FALSE;
			_busy := TRUE;
			_done := FALSE;
			_error := FALSE;
			Base_Library.Tracing.Trace.Verbose(Source := XtsName, Message := 'Mover Detection Sequence Started');
			MoverDetectionState := XtsMoverDetectionState.SetATrackForDetection;
		END_IF
	XtsMoverDetectionState.SetATrackForDetection:
		Base_Library.Tracing.Trace.Verbose(Source := XtsName, Message := 'Track 1 set for detection');
		IXtsTracks[0].SetForDetection();
		MoverDetectionState := XtsMoverDetectionState.TriggeringRedetection;
	
	XtsMoverDetectionState.TriggeringRedetection:
		Base_Library.Tracing.Trace.Verbose(Source := XtsName, Message := 'Mover Redetection Started');
		IF iXPU.TriggerRedetection() THEN
			MoverDetectionState := XtsMoverDetectionState.WaitingForAllMoversValid;
		END_IF
		
	XtsMoverDetectionState.WaitingForAllMoversValid:
		IF iXPU.GetAreAllPositionsValid() THEN
			Base_Library.Tracing.Trace.Verbose(Source := XtsName, Message := 'All Movers Valid');
			MoverDetectionState := XtsMoverDetectionState.CheckingAllMoverFound;
		END_IF
	
	XtsMoverDetectionState.CheckingAllMoverFound:
		IF iXPU.GetExpectedMoverCount() = iXPU.GetDetectedMoverCount() THEN
			Base_Library.Tracing.Trace.Verbose(Source := XtsName, Message := 'Configured Movers = Detected Movers');
			_DetectedMoverCount := iXPU.GetDetectedMoverCount();
			MoverDetectionState := XtsMoverDetectionState.TriggeringMoverIdDetection;
		END_IF
		
	XtsMoverDetectionState.TriggeringMoverIdDetection:
		IF iXPU.GetMoverIdDetectionMode() = MoverIdDetectionMode.Standard OR_ELSE SUCCEEDED(TriggerMoverIDDetection()) THEN
			Base_Library.Tracing.Trace.Verbose(Source := XtsName, Message := 'Mover ID Detection Complete');
			MoverDetectionState := XtsMoverDetectionState.WaitingForCommandStart;
			_busy := FALSE;
			_done := TRUE;
		END_IF
		
	XtsMoverDetectionState.MoverDetectionFault:
		IF ResetFlag THEN
			ResetFlag := FALSE;
			_error := FALSE;
			MoverDetectionState := XtsMoverDetectionState.WaitingForCommandStart;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="DetectedMoverCount" Id="{8f21e2a7-94e9-4fac-bf40-130830a6435e}">
      <Declaration><![CDATA[PROPERTY DetectedMoverCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{5b263380-d748-41dd-bfd1-9acc88eb9015}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[DetectedMoverCount := _DetectedMoverCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
