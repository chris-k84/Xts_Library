    <Method Name="Reset" Id="{4debf444-f915-47ef-8621-fa026afbedd9}">
      <Declaration><![CDATA[METHOD Reset : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResetFlag := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetComponents" Id="{85ce5b9a-63bb-4bb2-bedb-42a81ea16fe0}">
      <Declaration><![CDATA[METHOD SetComponents : BOOL
VAR_INPUT
	XtsTracks : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsTracksPerXpu] OF I_XtsTrack;
	MoverArray : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF I_XtsMover;
	XPU : I_TcIoXtsProcessingUnit;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iXtsTracks := XtsTracks;
iMoverArray := MoverArray;
iXPU := XPU;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{507dae7d-fc01-4c32-8358-312d0dae6a9b}">
      <Declaration><![CDATA[METHOD Start : HRESULT
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StartFlag := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TriggerMoverIdDetection" Id="{49e4cae6-2a7e-45cb-ba80-e12b965b943f}">
      <Declaration><![CDATA[METHOD PRIVATE TriggerMoverIdDetection : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoverIdDetectionError 	:= MoverIdDetectionState = MoverIdDetectionStateEnum.Error;
MoverIdDetected 	:= MoverIdDetectionState = MoverIdDetectionStateEnum.Valid;
MoverIdDetectionState	:= iXPU.GetMoverIdDetectionState();

IF iXPU.GetMoverIdDetectionMode() = MoverIdDetectionMode.Standard THEN
	TriggerMoverIDDetection := -1;
	RETURN;
END_IF
// 
IF MoverIdDetectionState = MoverIdDetectionStateEnum.Running THEN
	TriggerMoverIDDetection := -2;
	RETURN;
END_IF

iXPU.TriggerMoverIdDetection();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>