      <Declaration><![CDATA[PROPERTY Name : T_MAXSTRING]]></Declaration>
      <Get Name="Get" Id="{eeb06967-34c8-4544-b485-ab92c5ed582c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
