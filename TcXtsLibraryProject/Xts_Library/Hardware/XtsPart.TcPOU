<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsPart" Id="{39541d00-22ec-4750-829d-4864a624597e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsPart EXTENDS CyclicBase IMPLEMENTS I_Initialisable, I_XtsPart
VAR
	_MyInterface : Tc3_XTS_Utility.I_TcIoXtsXpuPart;
	MyModuleCount : UDINT;
	Status : XtsPartStatus;
	IMyModules : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxModulesPerPart] OF I_XtsMotorModule;
	ModuleIndex: UDINT := 1;
	_IsInitialised : BOOL := FALSE;
	PartLength: LREAL;
	_HasError : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Commands" Id="{96cca420-4049-45e9-b3ee-b3f2b2740148}" />
    <Folder Name="Settings" Id="{69a5ccb4-8b3d-4fa1-b2f7-542c5c4d49f1}" />
    <Folder Name="Status" Id="{6a88af9c-5ee8-475f-986e-7995dd992559}" />
    <Method Name="Cycle" Id="{6aa26807-846b-4168-ab87-fb4c66b138eb}">
      <Declaration><![CDATA[METHOD PUBLIC  Cycle : HRESULT
VAR
	i : INT;
	tempErrorID : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	Cycle := -1;
	RETURN;
END_IF

IF _OperationMode = OperationMode.Simulation THEN
	RETURN;
END_IF

Status.PartDriveState := _MyInterface.GetDriveState();
Status.IsDCLinkReady := _MyInterface.GetIsDcLinkVoltageReady();
Status.IsPartActive := _MyInterface.GetIsActive();
Status.AllModuleSsInOP := _MyInterface.GetAreAllModulesInOp();

_HasError := FALSE;
_HasError := (Status.PartDriveState = DriveState.Fault) OR 
				(Status.PartDriveState = DriveState.FaultReactionActive) OR
				(NOT Status.IsDCLinkReady);
				
status.ModuleControlVoltageOK := TRUE;
FOR i := 0 TO (UDINT_TO_UINT(MyModuleCount) - 1) DO
	IF NOT iMyModules[i].ControlVdcOK THEN
		status.ModuleControlVoltageOK := FALSE;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasError" Id="{9f27faee-7288-49b0-b8b5-9209e3993178}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY HasError : BOOL]]></Declaration>
      <Get Name="Get" Id="{24f72123-333a-4c51-8f13-0cc8f2466b17}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasError := _HasError;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Initialise" Id="{f7bcb601-a320-4f3f-bcf3-5ec4e45a7245}">
      <Declaration><![CDATA[METHOD Initialise : HRESULT
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	Initialise := -1;
	Base_Library.Tracing.Trace.Error(_Name, 'No XPU interface for Init');
	RETURN;
END_IF

IF NOT _MyInterface.P_IsInitialized THEN
	Initialise := -2;
	Base_Library.Tracing.Trace.Error(_Name, 'XPU Interface not ready');
	RETURN;
END_IF

Base_Library.Tracing.Trace.Verbose(_Name, 'Part Init Success');
MyModuleCount := _MyInterface.P_ModuleCount;
PartLength := _MyInterface.GetLength();
_IsInitialised := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialised" Id="{04d33ea5-0203-4e33-90cc-f8a328055a12}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY Initialised : BOOL]]></Declaration>
      <Get Name="Get" Id="{feb9aace-da91-4a57-a9c4-b03d0ed03a92}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialised := _IsInitialised;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PartStatus" Id="{f6d4538d-bfc8-4957-b777-8eaf1c090b88}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY PartStatus : XtsPartStatus]]></Declaration>
      <Get Name="Get" Id="{f7203cab-3794-483e-806f-411d2264085f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PartStatus := Status;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ResetPart" Id="{a2c1bf74-a00f-4e37-abd0-e53201644a52}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD ResetPart : BOOL
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResetPart := _MyInterface.TriggerReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetModuleInPArt" Id="{d12c324f-b2df-4a43-aeae-30441a6984fe}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD SetModuleInPArt : HRESULT
VAR_INPUT
	Module : I_XtsMotorModule;
END_VAR
VAR
	i : UINT;
	ModuleResgitered : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Module = 0 THEN
	Base_Library.Tracing.Trace.Warning(_Name, 'Register Module Fail - Null interface');
	SetModuleInPArt := -1;
	RETURN;
END_IF

FOR i := 0 TO (TO_INT(MyModuleCount) - 1) DO
	IF IMyModules[i] = Module THEN
		ModuleResgitered := TRUE;
		EXIT;
	END_IF
END_FOR
IF ModuleResgitered THEN
	Base_Library.Tracing.Trace.Warning(_Name, 'Register Module Fail - registered');
	SetModuleInPArt := -2;
	RETURN;
END_IF

FOR i := 0 TO (TO_INT(MyModuleCount) - 1) DO
	IF IMyModules[i] = 0 THEN
		IMyModules[i] := Module;
		EXIT;
	END_IF
END_FOR
Base_Library.Tracing.Trace.Verbose(_Name, 'Register Module success');]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPartOriginTransform" Id="{8b2a2802-8f42-46b7-9bd8-2e1c722c9321}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD SetPartOriginTransform : BOOL
VAR_INPUT
	OriginTransform: Tc3_XTS_Utility.ST_OriginTransform;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MyInterface.SetOriginTransform(OriginTransform);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetXtsIoPartInterface" Id="{d1025a27-9821-411e-834b-00448b7a7ed4}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD SetXtsIoPartInterface : HRESULT
VAR_INPUT
	PartInterface : Tc3_XTS_Utility.I_TcIoXtsXpuPart;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF PartInterface = 0 THEN
	Base_Library.Tracing.Trace.Error(_name, 'Part XPU interface not registered');
	SetXtsIoPartInterface := -1;
	RETURN;
END_IF


Base_Library.Tracing.Trace.Verbose(_name, 'Part XPU interface registered ok');
_MyInterface := PartInterface;
_Name := _MyInterface.P_ObjectName;

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>