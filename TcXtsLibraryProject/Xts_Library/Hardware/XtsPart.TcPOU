<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsPart" Id="{39541d00-22ec-4750-829d-4864a624597e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsPart EXTENDS CyclicBase IMPLEMENTS I_Initialisable, I_XtsPart
VAR
	_MyInterface : Tc3_XTS_Utility.I_TcIoXtsXpuPart;
	XtsIoEnvInitialiseState : INT;
	MyModuleCount : UDINT;
	Status : XtsPartStatus;
	XtsModules : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxModulesPerPart] OF XtsMotorModule('');
	iXtsModules : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxModulesPerPart] OF I_XtsMotorModule;
	PartStateRisingError: R_TRIG;	
	PartStateFallingError: F_TRIG;	
	ModuleIndex: UDINT := 1;
	CurrentErrorId : UDINT;
	InSim : BOOL;
	PartName: STRING;
	_IsInitialised : BOOL := FALSE;
	_OperationMode: OperationMode;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Commands" Id="{96cca420-4049-45e9-b3ee-b3f2b2740148}" />
    <Folder Name="Settings" Id="{69a5ccb4-8b3d-4fa1-b2f7-542c5c4d49f1}" />
    <Folder Name="Status" Id="{6a88af9c-5ee8-475f-986e-7995dd992559}" />
    <Method Name="Cycle" Id="{6aa26807-846b-4168-ab87-fb4c66b138eb}">
      <Declaration><![CDATA[METHOD PUBLIC  Cycle : HRESULT
VAR
	i : INT;
	tempErrorID : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	Cycle := -1;
	RETURN;
END_IF

IF _OperationMode = OperationMode.Simulation THEN
	RETURN;
END_IF

Status.PartDriveState := _MyInterface.GetDriveState();
Status.IsDCLinkReady := _MyInterface.GetIsDcLinkVoltageReady();
Status.IsPartActive := _MyInterface.GetIsActive();
Status.AllModuleSsInOP := _MyInterface.GetAreAllModulesInOp();

status.HasError := (Status.PartDriveState = DriveState.Fault) OR 
				(Status.PartDriveState = DriveState.FaultReactionActive);

PartStateRisingError(CLK := status.HasError);
PartStateFallingError(CLK := status.HasError);
IF PartStateRisingError.Q THEN
	Base_Library.Tracing.Trace.Error(_Name, 'Part In Error');
END_IF
IF PartStateFallingError.Q THEN
	Base_Library.Tracing.Trace.Info(_Name, 'Part Error Cleared');
END_IF
			
status.ModuleControlVoltageOK := TRUE;
FOR i := 0 TO (UDINT_TO_UINT(MyModuleCount) - 1) DO
	IF NOT iXtsModules[i].ControlVdcOK THEN
		status.ModuleControlVoltageOK := FALSE;
	END_IF
END_FOR

FOR i := 0 TO (UDINT_TO_UINT(MyModuleCount) - 1) DO
	XtsModules[i].Cycle();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasError" Id="{9f27faee-7288-49b0-b8b5-9209e3993178}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY HasError : BOOL]]></Declaration>
      <Get Name="Get" Id="{24f72123-333a-4c51-8f13-0cc8f2466b17}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasError := Status.HasError;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Initialise" Id="{f7bcb601-a320-4f3f-bcf3-5ec4e45a7245}">
      <Declaration><![CDATA[METHOD Initialise : HRESULT
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Initialise := -1;
CASE XtsIoEnvInitialiseState OF
	0:
		IF _MyInterface <> 0 THEN
			XtsIoEnvInitialiseState := 1;
		ELSE
			XtsIoEnvInitialiseState := 999;
		END_IF
	1:
		MyModuleCount := _MyInterface.P_ModuleCount;
		IF _OperationMode = OperationMode.Simulation THEN
			XtsIoEnvInitialiseState := 3;
			FOR i := 0 TO UDINT_TO_UINT(MyModuleCount - 1) DO
				XtsModules[i].SetModuleOperationMode(Mode := OperationMode.Simulation);
				iXtsModules[i] := XtsModules[i];
			END_FOR
		ELSE
			FOR i := 0 TO UDINT_TO_UINT(MyModuleCount - 1) DO
				XtsModules[i].SetXtsIoModuleInterface(_MyInterface.ModuleTcIo(i + 1));
				iXtsModules[i] := XtsModules[i];
			END_FOR
			XtsIoEnvInitialiseState := 2;
		END_IF
		
	2:
		XtsIoEnvInitialiseState := 3;
		FOR i := 0 TO UDINT_TO_UINT(MyModuleCount-1) DO
			IF FAILED(XtsModules[i].Initialise()) THEN
				XtsIoEnvInitialiseState := 2;
			END_IF
		END_FOR
	3:
		PartName := _MyInterface.P_ObjectName;
		Initialise := 0;
		_IsInitialised := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialised" Id="{04d33ea5-0203-4e33-90cc-f8a328055a12}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY Initialised : BOOL]]></Declaration>
      <Get Name="Get" Id="{feb9aace-da91-4a57-a9c4-b03d0ed03a92}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialised := _IsInitialised;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="PartStatus" Id="{f6d4538d-bfc8-4957-b777-8eaf1c090b88}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY PartStatus : XtsPartStatus]]></Declaration>
      <Get Name="Get" Id="{f7203cab-3794-483e-806f-411d2264085f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[PartStatus := Status;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ResetPart" Id="{a2c1bf74-a00f-4e37-abd0-e53201644a52}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD ResetPart : BOOL
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResetPart := _MyInterface.TriggerReset();
IF NOT InSim THEN
	FOR i := 0 TO (UDINT_TO_UINT(MyModuleCount) - 1) DO
		XtsModules[i].AcknowledgeMessages();
	END_FOR
END_IF	]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPartOperationMode" Id="{3d03b392-5590-4afc-85ba-e5ffd6ca9ea3}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD SetPartOperationMode : hresult
VAR_INPUT
	Mode : OperationMode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_OperationMode := Mode;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPartOriginTransform" Id="{8b2a2802-8f42-46b7-9bd8-2e1c722c9321}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD SetPartOriginTransform : BOOL
VAR_INPUT
	OriginTransform: Tc3_XTS_Utility.ST_OriginTransform;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MyInterface.SetOriginTransform(OriginTransform);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetXtsIoPartInterface" Id="{d1025a27-9821-411e-834b-00448b7a7ed4}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD SetXtsIoPartInterface : HRESULT
VAR_INPUT
	PartInterface : Tc3_XTS_Utility.I_TcIoXtsXpuPart;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF PartInterface = 0 THEN
	Base_Library.Tracing.Trace.Error(_name, 'Part XPU interface not registered');
	SetXtsIoPartInterface := -1;
	RETURN;
END_IF


_MyInterface := PartInterface;
_Name := _MyInterface.P_ObjectName;
Base_Library.Tracing.Trace.Verbose(_name, 'Part XPU interface registered ok');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>