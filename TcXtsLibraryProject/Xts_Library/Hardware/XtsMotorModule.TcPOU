<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsMotorModule" Id="{447db564-ab24-433c-b078-4cedd1c7411e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsMotorModule EXTENDS CyclicBase IMPLEMENTS I_Initialisable, I_XtsMotorModule
VAR
	_MyInterface : I_TcIoXtsPartModule;
	_IsInitialised : BOOL;
	Nominal24Vdc : REAL := 24.0;
	Nominal48Vdc : REAL := 48.0;
	Module24Vdc: REAL;
	Module48Vdc: REAL;
	ModuleState: Tc3_XTS_Utility.DriveState;
	ModuleStatus: Tc3_XTS_Utility.CoeStatusInfo;
	MotorOid: OTCID;
	SensorOid: OTCID;
	_BTN: BTN;
	_Infeed : BOOL;
	_OperationMode : OperationMode;
	Status : XtsModuleStatus;
	DiagHistory: ARRAY [1..Tc3_XTS_Utility.TcIoXtsEnvironmentParameterList.MaxDiagMessagesPerModule] OF Tc3_XTS_Utility.DiagHistoryEntry;
	ControlVoltageErrorRisingTrigger : R_TRIG;
	ControlVoltageErrorFallingTrigger : F_TRIG;
	MotorVoltageErrorRisingTrigger : R_TRIG;
	MotorVoltageErrorFallingTrigger : F_TRIG;
	ModuleStateRisingError : R_TRIG;
	ModuleStateFallingError : F_TRIG;
END_VAR
VAR CONSTANT
	Nominal24Vdc : REAL := 24.0;
	Nominal48Vdc : REAL := 48.0;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Commands" Id="{2c57c3e7-9e33-442c-b661-553dd998e7e1}" />
    <Folder Name="Settings" Id="{a31ea8a5-3ecf-4e96-bec6-1505f77550e4}" />
    <Folder Name="Status" Id="{068e24b8-ffac-477a-847b-d306caa5617e}" />
    <Method Name="AcknowledgeMessages" Id="{22451bbb-5ae0-42af-9e4d-a9e5962b9f38}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD AcknowledgeMessages : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	RETURN;
END_IF

AcknowledgeMessages := TRUE;
_MyInterface.TriggerAcknowledgeMessages();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ControlVdcOK" Id="{2528651b-d48c-4c45-aa23-04cc6babc183}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY ControlVdcOK : BOOL]]></Declaration>
      <Get Name="Get" Id="{c497a289-f203-435a-9fe1-0c3e338da054}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ControlVdcOK := Status.ControlVdcOK;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cycle" Id="{1188f197-bbd0-4970-903a-af249f1ed9e0}">
      <Declaration><![CDATA[METHOD PUBLIC  Cycle : HRESULT
VAR_INPUT
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	Cycle := -1;
	RETURN;
END_IF

CurrentLive:= _MyModuleIoInterface.GetOverallCurrent();
MaxCurrent:=  _MyModuleIoInterface.GetMaxOverallCurrentLast500ms();
Module24Vdc := _MyModuleIoInterface.GetAuxiliaryVoltage24V();
Module48Vdc := _MyModuleIoInterface.GetDCLinkVoltage();
ModuleState := _MyModuleIoInterface.GetDriveState();
ModuleStatus := _MyModuleIoInterface.GetDriveStatusInfo();
EtherCATState := _MyModuleIoInterface.GetDriveEtherCatSlaveStateInfo();

IF _MyInterface.GetHasActiveError() THEN
	DiagHistory := _MyInterface.GetLatestMessages();
END_IF

Status.ControlVdcOK := (Status.Module24Vdc > (Nominal24Vdc * 0.8)) AND (Status.Module24Vdc < (Nominal24Vdc * 1.2));
ControlVoltageErrorRisingTrigger(CLK :=  NOT Status.ControlVdcOK);
IF ControlVoltageErrorRisingTrigger.Q THEN
	Base_Library.Tracing.Trace.Error(_name,'Control Voltage out of range');
END_IF
ControlVoltageErrorFallingTrigger(CLK :=  NOT Status.ControlVdcOK);
IF ControlVoltageErrorFallingTrigger.Q THEN
	Base_Library.Tracing.Trace.Info(_name,'Control Voltage in range');
END_IF

Status.MotorVdcOK := (Status.Module48Vdc > (Nominal48Vdc * 0.8)) AND (Status.Module48Vdc < (Nominal48Vdc * 1.2));
MotorVoltageErrorRisingTrigger(CLK := NOT Status.MotorVdcOK);
IF MotorVoltageErrorRisingTrigger.Q THEN
	Base_Library.Tracing.Trace.Error(_name, 'Motor voltage out of range');
END_IF
MotorVoltageErrorFallingTrigger(CLK := NOT Status.MotorVdcOK);
IF MotorVoltageErrorFallingTrigger.Q THEN
	Base_Library.Tracing.Trace.Info(_name, 'Motor voltage in range');
END_IF

Status.ModuleInFault := Status.ModuleDriveState = DriveState.Fault OR Status.ModuleDriveState = DriveState.FaultReactionActive;
ModuleStateRisingError(CLK := Status.ModuleInFault);
ModuleStateFallingError(CLK := Status.ModuleInFault);
IF ModuleStateRisingError.Q THEN
	Base_Library.Tracing.Trace.Error(_name, 'Module in error state');
END_IF
IF ModuleStateFallingError.Q THEN
	Base_Library.Tracing.Trace.Info(_name, 'Module in normal state');
END_IF

_HasError := NOT Status.ControlVdcOK OR NOT Status.MotorVdcOK OR Status.ModuleInFault;]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasError" Id="{ad2a93c0-6ba6-42ce-9110-768a7019bac4}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY HasError : BOOL]]></Declaration>
      <Get Name="Get" Id="{8ea1610f-f288-4ad1-9662-3ab9ae557be5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasError := _HasError;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Initialise" Id="{0d230f78-299f-458d-bcac-a537a1290197}">
      <Declaration><![CDATA[METHOD Initialise : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	Initialise := -1;
	Base_Library.Tracing.Trace.Error(_Name, 'No XPU interface for Init');
	RETURN;
END_IF

MotorOid := _MyModuleIoInterface.GetMotorTerminalOid();
SensorOid := _MyModuleIoInterface.GetSensorTerminalOid();
_Name := _MyModuleIoInterface.P_ObjectName;
_BTN := _MyModuleIoInterface.GetDriveBTN();
_Infeed := _MyModuleIoInterface.GetIsInfeed();
_IsInitialised := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialised" Id="{5149f147-92a6-4662-be65-a10eccccf631}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY Initialised : BOOL]]></Declaration>
      <Get Name="Get" Id="{7ce6f34a-06d5-4124-9539-f315dce97e7b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialised := _IsInitialised;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ModuleStatus" Id="{6fc9c027-ec3a-4f11-b20a-3cf2deae906c}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY ModuleStatus : XtsModuleStatus]]></Declaration>
      <Get Name="Get" Id="{bfc69e45-cdd3-4b3f-a38e-4a3662601048}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ModuleStatus := Status;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetXtsIoPartInterface" Id="{d64a5400-2bf3-4adc-add3-a7c7ebe7eeb1}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD SetXtsIoPartInterface : HRESULT
VAR_INPUT
	ModuleInterface : Tc3_XTS_Utility.I_TcIoXtsPartModule;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ModuleInterface <> 0 THEN
	_MyModuleIoInterface := ModuleInterface;
	_Name := _MyModuleIoInterface.P_ObjectName;
ELSE
	SetXtsIoPartInterface := -1;
END_IF

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>