<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsMotorModule" Id="{447db564-ab24-433c-b078-4cedd1c7411e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsMotorModule EXTENDS CyclicBase IMPLEMENTS I_Initialisable, I_XtsMotorModule
VAR
	_MyInterface : I_TcIoXtsPartModule;
	_IsInitialised : BOOL;
	_HasError : BOOL;
	MotorOid: OTCID;
	SensorOid: OTCID;
	_BTN: BTN;
	Status : XtsModuleStatus;
	DiagHistory: ARRAY [1..Tc3_XTS_Utility.TcIoXtsEnvironmentParameterList.MaxDiagMessagesPerModule] OF Tc3_XTS_Utility.DiagHistoryEntry;
END_VAR
VAR CONSTANT
	Nominal24Vdc : REAL := 24.0;
	Nominal48Vdc : REAL := 48.0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Commands" Id="{2c57c3e7-9e33-442c-b661-553dd998e7e1}" />
    <Folder Name="Settings" Id="{a31ea8a5-3ecf-4e96-bec6-1505f77550e4}" />
    <Folder Name="Status" Id="{068e24b8-ffac-477a-847b-d306caa5617e}" />
    <Method Name="AcknowledgeMessages" Id="{22451bbb-5ae0-42af-9e4d-a9e5962b9f38}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD AcknowledgeMessages : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	RETURN;
END_IF

AcknowledgeMessages := TRUE;
_MyInterface.TriggerAcknowledgeMessages();]]></ST>
      </Implementation>
    </Method>
    <Property Name="ControlVdcOK" Id="{2528651b-d48c-4c45-aa23-04cc6babc183}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY ControlVdcOK : BOOL]]></Declaration>
      <Get Name="Get" Id="{c497a289-f203-435a-9fe1-0c3e338da054}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ControlVdcOK := _ControlVdcOK;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Cycle" Id="{1188f197-bbd0-4970-903a-af249f1ed9e0}">
      <Declaration><![CDATA[METHOD PUBLIC  Cycle : HRESULT
VAR_INPUT
END_VAR
VAR
	i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	Cycle := -1;
	RETURN;
END_IF

Status.CurrentLive:= _MyModuleIoInterface.GetOverallCurrent();
Status.MaxCurrent:=  _MyModuleIoInterface.GetMaxOverallCurrentLast500ms();
Status.Module24Vdc := _MyModuleIoInterface.GetAuxiliaryVoltage24V();
Status.Module48Vdc := _MyModuleIoInterface.GetDCLinkVoltage();
Status.ModuleDriveState := _MyModuleIoInterface.GetDriveState();
ModuleStatus := _MyModuleIoInterface.GetDriveStatusInfo();
Status.ModuleEtherCATState := _MyModuleIoInterface.GetDriveEtherCatSlaveStateInfo();

IF _MyModuleIoInterface.GetHasActiveError() THEN
	DiagHistory := _MyModuleIoInterface.GetLatestMessages();
END_IF

Status.ControlVdcOK := TRUE;
IF (Status.Module24Vdc < (Nominal24Vdc * 0.8)) OR (Status.Module24Vdc > (Nominal24Vdc * 1.2)) THEN
	Base_Library.Tracing.Trace.Error(_name,'Control Voltage out of range');
	Status.ControlVdcOK := FALSE;
END_IF

Status.MotorVdcOK := TRUE;
IF (Status.Module48Vdc < (Nominal48Vdc * 0.8)) OR (Status.Module48Vdc > (Nominal48Vdc * 1.2)) THEN
	Base_Library.Tracing.Trace.Error(_name, 'Motor voltage out of range');
	Status.MotorVdcOK := FALSE;
END_IF

IF Status.ModuleDriveState = DriveState.Fault OR Status.ModuleDriveState = DriveState.FaultReactionActive THEN
	_HasError := TRUE;
	Base_Library.Tracing.Trace.Error(_name, 'Module in error state');
ELSE
	_HasError := FALSE;
END_IF

]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasError" Id="{ad2a93c0-6ba6-42ce-9110-768a7019bac4}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY HasError : BOOL]]></Declaration>
      <Get Name="Get" Id="{8ea1610f-f288-4ad1-9662-3ab9ae557be5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasError := _HasError;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Initialise" Id="{0d230f78-299f-458d-bcac-a537a1290197}">
      <Declaration><![CDATA[METHOD Initialise : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyModuleIoInterface = 0 THEN
	Initialise := -1;
	Base_Library.Tracing.Trace.Error(_Name, 'No XPU interface for Init');
	RETURN;
END_IF

IF NOT _MyModuleIoInterface.P_IsInitialized THEN
	Initialise := -2;
	Base_Library.Tracing.Trace.Error(_Name, 'XPU Interface not ready');
	RETURN;
END_IF

MotorOid := _MyModuleIoInterface.GetMotorTerminalOid();
SensorOid := _MyModuleIoInterface.GetSensorTerminalOid();
Status.IsInfeed := _MyModuleIoInterface.GetIsInfeed();
_IsInitialised := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialised" Id="{5149f147-92a6-4662-be65-a10eccccf631}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY Initialised : BOOL]]></Declaration>
      <Get Name="Get" Id="{7ce6f34a-06d5-4124-9539-f315dce97e7b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialised := _IsInitialised;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ModuleStatus" Id="{6fc9c027-ec3a-4f11-b20a-3cf2deae906c}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY ModuleStatus : XtsModuleStatus]]></Declaration>
      <Get Name="Get" Id="{bfc69e45-cdd3-4b3f-a38e-4a3662601048}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="MotorVdcOK" Id="{7e0a9c2a-7b16-4c93-896b-922544ce7154}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY MotorVdcOK : BOOL]]></Declaration>
      <Get Name="Get" Id="{cc82d0c3-e4a9-4072-a811-8d3f6ad007d9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MotorVdcOK := _MotorVdcOK;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetXtsIoModuleInterface" Id="{d64a5400-2bf3-4adc-add3-a7c7ebe7eeb1}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD SetXtsIoModuleInterface : HRESULT
VAR_INPUT
	ModuleInterface : Tc3_XTS_Utility.I_TcIoXtsPartModule;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ModuleInterface <> 0 THEN
	_MyModuleIoInterface := ModuleInterface;
	_Name := _MyModuleIoInterface.P_ObjectName;
	_BTN := _MyModuleIoInterface.GetDriveBTN();
	Base_Library.Tracing.Trace.Verbose(_name, 'XPU interface assigned ok');
ELSE
	SetXtsIoModuleInterface := -1;
	Base_Library.Tracing.Trace.Error(_name, 'XPU interface not assigned');
END_IF

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>