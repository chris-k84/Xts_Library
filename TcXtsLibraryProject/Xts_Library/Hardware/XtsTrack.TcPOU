<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsTrack" Id="{0ed646c8-24dd-40d8-b451-d6e6a88b90d3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsTrack EXTENDS CyclicBase IMPLEMENTS I_XtsTrack, I_Initialisable
VAR
	_MyInterface : I_TcIoXtsXpuTrack;
	MyPartCount : UDINT;
	Parts : REFERENCE TO ARRAY[1..TcIoXtsEnvironmentParameterList.MaxPartsPerTrack] OF ST_PartInfoItems;
	_TrackLength: LREAL;
	_TrackIsClosed: BOOL;
	_OTCID : OTCID;
	_IsTrackIncludedForDetection : BOOL;
	_NumberOfPartsInTrack : INT;
	_TrackPolarity: Tc3_XTS_Utility.Polarity;
	_IsInitialised : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Commands" Id="{32cad632-fbd4-445a-b2c2-d8eaa1f5efa0}" />
    <Folder Name="Settings" Id="{b0f2811b-01c3-4263-ae13-de05f982e5bb}" />
    <Folder Name="Status" Id="{574d2b11-115b-44b2-972f-d3d465c1b172}" />
    <Method Name="Cycle" Id="{753f4845-bb32-46bd-9afe-0c535a6bb9c5}">
      <Declaration><![CDATA[METHOD PUBLIC  Cycle : HRESULT
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	Cycle := -1;
	RETURN;
END_IF

_IsTrackIncludedForDetection := _MyInterface.GetIsIncludedInDetection();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialise" Id="{b15a1974-ae41-45a0-b8ce-e38654aa0808}">
      <Declaration><![CDATA[METHOD Initialise : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	Initialise := -1;
	Base_Library.Tracing.Trace.Error(_Name, 'No XPU interface for Init');
	RETURN;
END_IF

IF NOT _MyInterface.P_IsInitialized THEN
	Initialise := -2;
	Base_Library.Tracing.Trace.Error(_Name, 'XPU Interface not ready');
	RETURN;
END_IF



MyPartCount := _MyInterface.GetPartCount();
Parts REF= _MyInterface.GetPartInfoItems();
_TrackLength := _MyInterface.GetLength();
_TrackIsClosed := _MyInterface.GetIsClosed();
_TrackPolarity := _MyInterface.GetPolarity();
_NumberOfPartsInTrack := TO_INT(_MyInterface.GetPartCount());

_IsInitialised := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialised" Id="{339e97b4-50a8-4342-a310-e8536eaede2f}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY Initialised : BOOL]]></Declaration>
      <Get Name="Get" Id="{76068666-6775-4f24-bbb9-a431dc2f8a5e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialised := _IsInitialised;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsTrackSetForDetection" Id="{6d41100e-3e9f-436d-ac19-0ea590bc8b77}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY IsTrackSetForDetection : BOOL]]></Declaration>
      <Get Name="Get" Id="{7a14784a-3e20-4412-b81b-078373782f42}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsTrackSetForDetection := _IsTrackIncludedForDetection;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="NumberOfPartsInTrack" Id="{4227d870-553b-4fcb-8516-6ae7f6500149}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY NumberOfPartsInTrack : INT]]></Declaration>
      <Get Name="Get" Id="{47e7e73c-f2f4-4613-aa92-016379f2eda9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[NumberOfPartsInTrack := _NumberOfPartsInTrack;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RemoveFromDetection" Id="{19fc9c17-6e83-4583-8661-ca0f3d7fbe00}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD RemoveFromDetection : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RemoveFromDetection := _MyInterface.SetIsIncludedInDetection(False);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetForDetection" Id="{2a4c4b2d-af72-4d4f-81aa-5409f825db3c}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD SetForDetection : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetForDetection := _MyInterface.SetIsIncludedInDetection(TRUE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetXtsIoTrackInterface" Id="{06598758-8638-4586-bb3c-21c1027f163e}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD SetXtsIoTrackInterface : HRESULT
VAR_INPUT
	Track : I_TcIoXtsXpuTrack;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Track = 0 THEN
	SetXtsIoTrackInterface := -1;
	Base_Library.Tracing.Trace.Error(_name, 'Track XPU interface not registered');
	RETURN;
END_IF

Base_Library.Tracing.Trace.Verbose(_name, 'Part XPU interface registered ok');
_MyInterface := Track;
_OTCID := _MyInterface.P_ObjectId;
_Name := _MyInterface.P_ObjectName;]]></ST>
      </Implementation>
    </Method>
    <Property Name="TrackLength" Id="{f63b8800-afc4-4a64-a819-7bbd5ce82fd4}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY TrackLength : MC_Lreal]]></Declaration>
      <Get Name="Get" Id="{8c76ee9b-64b1-4933-b3fe-20fbe5dcfddc}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TrackLength := _MyInterface.GetLength();]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TrackOTCID" Id="{ecd1a52d-79c4-481e-8400-e1243b100776}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY TrackOTCID : OTCID]]></Declaration>
      <Get Name="Get" Id="{33e1ea11-5a56-4ac4-bbde-7b321485f67d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TrackOTCID := _OTCID;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>