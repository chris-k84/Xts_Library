<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StationBehaviour" Id="{50af290e-a0d7-45b3-a647-c8828b096bd1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK StationBehaviour EXTENDS CyclicBase IMPLEMENTS I_Resettable
VAR
	State : StationBehaviourState;  
	iCurrentStation : I_Station;
	_StationPosition : MC_LREAL;
	stSequenceInfo : StationBehaviourInfo;
	iMover : I_XtsMover;
	iStationManager : I_StationManager;
	ExecuteSequence : BOOL;
	_NonModuloMoves : BOOL := FALSE;
	_Velocity : LREAL;
	_Acceleration : LREAL;
	_Deceleration : LREAL;
	_Jerk : LREAL;
	_Gap : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[{analysis -2}]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{0bc270b2-0e7a-4545-b872-87f2d15ca3f5}">
      <Declaration><![CDATA[METHOD PUBLIC Cycle : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE State OF
	
	StationBehaviourState.WaitingForMoverReady:
		IF iMover.IsEnabled THEN
			State := StationBehaviourState.WaitingForStart;
		END_IF
	StationBehaviourState.WaitingForStart:
		IF ExecuteSequence THEN
			State := StationBehaviourState.RequestingDestination;
		END_IF
    StationBehaviourState.RequestingDestination:
		iCurrentStation := iStationManager.RequestNextStation(iCurrentStation);
		State := StationBehaviourState.TriggeringMoveToStation;
    StationBehaviourState.TriggeringMoveToStation:
		IF SUCCEEDED(iMover.MoveTo(RequiredPosition := iCurrentStation.Position,
						MoveVelocity := _Velocity,
						NonModuloMove := FALSE)) THEN
			State := StationBehaviourState.MovingToDestination;
		ELSE
			;
		END_IF
    StationBehaviourState.MovingToDestination:

    StationBehaviourState.ConfirmingArrival:
		IF iMover.IsStationary AND NOT iMover.IsAvoidingCollision THEN 
			IF (iMover.ActualTrackPosition > iCurrentStation.Position - 0.1 AND iMover.ActualTrackPosition < iCurrentStation.Position + 0.1) THEN
				State := StationBehaviourState.WaitingForStationProcess;
				iCurrentStation.MyMover(THIS^);
			END_IF
		END_IF
	
    StationBehaviourState.WaitingForStationProcess:
		
    StationBehaviourState.ExecutingStationProcess:
		
    StationBehaviourState.ReleasingStation:
		
    StationBehaviourState.Stopped:
    StationBehaviourState.Error:

		
		
	
	StationBehaviourState.ArrivedAtStation:
		IF SUCCEEDED(StationArray[CurrentStation].MyMover(ThisMover)) THEN
			IF __QUERYINTERFACE(StationArray[CurrentStation],Process) THEN
				State := StationBehaviourState.StartingProcess;
			ELSE
				State := StationBehaviourState.WaitingForStationComplete;
			END_IF
		END_IF
		
	StationBehaviourState.MoverQueueingAtStation:
		IF NOT iMover.IsStationary THEN
				State := StationBehaviourState.MovingToCurrentStation;
		END_IF

	StationBehaviourState.WaitingForStationComplete:
		IF StationArray[CurrentStation].isComplete() THEN
			State := StationBehaviourState.CheckIfFinalStation;
		END_IF

	StationBehaviourState.StartingProcess:
		iMover.MoveTo(RequiredPosition := Process.EndPosition,
								MoveVelocity := Process.ProcessVelocity,
								NonModuloMove := _NonModuloMoves);
		State := StationBehaviourState.MoverInProcess;
								
	StationBehaviourState.MoverInProcess:
		IF iMover.IsStationary THEN 
			IF (iMover.ActualTrackPosition > Process.EndPosition - 0.3 AND iMover.ActualTrackPosition < Process.EndPosition + 0.3) THEN
				State := StationBehaviourState.CheckIfFinalStation;
			END_IF
		END_IF
	
	StationBehaviourState.CheckIfFinalStation:
		IF iCurrentStation = StationNumber - 1 THEN
			iCurrentStation := 0; 
			TargetStationPosition := StationArray[CurrentStation].Position;
			IF SUCCEEDED(iMover.MoveTo(RequiredPosition := TargetStationPosition,
							MoveVelocity := _MoverVelocity,
							NonModuloMove := _NonModuloMoves)) THEN
				State := StationBehaviourState.MovingToCurrentStation;
			END_IF
		ELSE
			State := StationBehaviourState.MovingToNextStation;
		END_IF
		
	StationBehaviourState.MovingToNextStation:
		TargetStationPosition := StationArray[CurrentStation + 1].Position;
		IF 	SUCCEEDED(iMover.MoveTo(RequiredPosition := TargetStationPosition,
							MoveVelocity := _MoverVelocity,
							NonModuloMove := _NonModuloMoves)) THEN	
			iCurrentStation := iCurrentStation + 1;
			State := StationBehaviourState.MovingToCurrentStation;
		END_IF	
	StationBehaviourState.Stopped;
		IF ExecuteSequence THEN
			TargetStationPosition := StationArray[CurrentStation].Position;
			IF iCurrentStation = 0 THEN
				IF 	SUCCEEDED(iMover.MoveTo(RequiredPosition := TargetStationPosition,
									MoveVelocity := _MoverVelocity,
									NonModuloMove := _NonModuloMoves)) THEN	
					State := StationBehaviourState.MovingToCurrentStation;
				END_IF	
			ELSE
				IF 	SUCCEEDED(iMover.MoveTo(RequiredPosition := TargetStationPosition,
									MoveVelocity := _MoverVelocity,
									NonModuloMove := _NonModuloMoves)) THEN	
					State := StationBehaviourState.MovingToCurrentStation;
				END_IF	
			END_IF
		END_IF
		
	StationBehaviourState.SequenceError:

	ELSE
		Cycle := E_FAIL;
END_CASE

//Cyclic update info data
stSequenceInfo.CurrentStation := UINT_TO_INT(iCurrentStation);
stSequenceInfo.MoverId := iMover.AxisRef.NcToPlc.AxisId;
stSequenceInfo.State := State;
stSequenceInfo.Velocity := iMover.AxisRef.NcToPlc.ActVelo;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{01dd3306-e903-4754-85c4-ea13c41e0b8c}">
      <Declaration><![CDATA[METHOD Reset : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[State := StationBehaviourState.WaitingForStart;
iCurrentStation := 0;
TargetStationPosition := 0.0;
stSequenceInfo.CurrentStation := UINT_TO_INT(iCurrentStation);
stSequenceInfo.MoverId := iMover.AxisRef.NcToPlc.AxisId;
stSequenceInfo.State := State;
stSequenceInfo.Velocity := iMover.AxisRef.NcToPlc.ActVelo;
ExecuteSequence := FALSE;
Reset := 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetDynamics" Id="{457b81b5-790d-467f-b5d4-a7cc5e910b6b}">
      <Declaration><![CDATA[METHOD SetDynamics : BOOL
VAR_INPUT
	Velocity : LREAL;
	Acceleration : LREAL;
	Deceleration : LREAL;
	Jerk : LREAL;
	Gap : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF iMover <> 0 THEN
	_Velocity := Velocity;
	_Acceleration := iMover.Acceleration := Acceleration;
	_Deceleration := iMover.Deceleration := Deceleration;
	_Jerk := iMover.Jerk := Jerk;
	_Gap := iMover.Gap := Gap;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMover" Id="{c7197946-5ad1-4459-b1bb-45e2cc4f592d}">
      <Declaration><![CDATA[METHOD SetMover : BOOL
VAR_INPUT
	Mover : I_XtsMover;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iMover := Mover;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetStationManager" Id="{8a2bc8de-e1dc-41af-9d71-20180e5df04f}">
      <Declaration><![CDATA[METHOD SetStationManager : BOOL
VAR_INPUT
	StationManager : I_StationManager;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iStationManager := StationManager;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StartIndexing" Id="{6e4b7f28-1f53-404c-b56b-f1310c888415}">
      <Declaration><![CDATA[METHOD StartIndexing : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ExecuteSequence := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopIndexing" Id="{6fcff83f-b689-4f39-8c14-494c41dd48fe}">
      <Declaration><![CDATA[METHOD StopIndexing : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[State := StationBehaviourState.Stopped;
iMover.HaltAxis();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>