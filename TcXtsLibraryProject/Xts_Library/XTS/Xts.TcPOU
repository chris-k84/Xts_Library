    <Method Name="Reset" Id="{f4cda3e0-308c-460d-87ee-c1616441d1b6}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD Reset : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Reset := SUCCEEDED(ICollisionGroup.Reset());
iXPU.TriggerResetAllParts();
Base_Library.Tracing.Trace.Verbose(_Name, 'Reset Accepted');]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetAPart" Id="{ea6e5381-c439-4c48-a079-83c8463314b8}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD PUBLIC ResetAPart : hresult
VAR_INPUT
	Part : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Part > MyPartCount THEN
	ResetAPart := -1;
END_IF

IF Part = 0 THEN
	ResetAPart := -2;
END_IF

IXtsParts[Part].ResetPart();]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopXts" Id="{4b648283-f5f4-4d47-a58f-be53e519365d}" FolderPath="Operations\">
