      </Set>
    </Property>
    <Method Name="FB_Init" Id="{d6ce6c85-5c43-4276-b07f-92a2e669b228}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change) 
	Name : T_MaxString;  
	MyXtsIoEnvVar : I_XtsIoEnvVar;
	MyXtsHardware : I_XtsHardware;
	MyCAGroup : I_CollisionGroup;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_XtsIoEnvVar := MyXtsIoEnvVar;
_MyXtsHardware := MyXtsHardware;
ICollisionGroup := MyCAGroup;
EnableSequence.MyCollisionGroup := ICollisionGroup;
DisableSequence.MyCollisionGroup := ICollisionGroup;]]></ST>
      </Implementation>
    </Method>
    <Property Name="HasError" Id="{fc5d4c9f-c257-47d7-8282-ec3a9f63c6e5}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY HasError : BOOL]]></Declaration>
      <Get Name="Get" Id="{e073db15-e4f5-4f0c-b72a-f5365dbb2c5c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasError := ICollisionGroup.HasError OR _MyXtsHardware.AnyPartsInError;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Initialise" Id="{3c52ae7d-89c5-4979-a1bd-5023a279947c}">
      <Declaration><![CDATA[METHOD Initialise : HRESULT
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Initialise := -1;
CASE XtsHwState OF
	XtsSystemInitialisation.WaitingForXtsIoEnvVar:
		IF NOT Initialising THEN
			Base_Library.Tracing.Trace.Info(Source := _Name, Message := 'Waiting for XTS_UtilityLib');
			Initialising := TRUE;
		END_IF
		IF _XtsIoEnvVar.Initialised THEN
			Base_Library.Tracing.Trace.Info(Source := _Name, Message := 'XTS_Utility Initiliased');
			_iXPU := _XtsIoEnvVar.GetXPUInterface(_MyXts);
			_name := _iXPU.P_ObjectName;
			XtsOperatingMode := _iXPU.GetOperationMode();
			_InSim := XtsOperatingMode = OperationMode.Simulation;
			_MyXtsHardware.MyXpu := _iXPU;
			EnableSequence.Name := _Name;
			DisableSequence.Name := _Name;
			XtsHwState := XtsSystemInitialisation.PassGroupReference;
		END_IF
		
	XtsSystemInitialisation.PassGroupReference:
		ICollisionGroup.CAGroupXtsIoEnvInterface := _XtsIoEnvVar.GetCaGroupInterface(_MyXts);
		XtsHwState := XtsSystemInitialisation.WaitingForHardwareToInitialise;
	
	XtsSystemInitialisation.WaitingForHardwareToInitialise:
		IF _MyXtsHardware.Initialised THEN
			Base_Library.Tracing.Trace.Verbose(Source := _name, Message := 'Mover Detection Sequence Started');
			XtsHwState := XtsSystemInitialisation.SetATrackForDetection;
		END_IF
	
	XtsSystemInitialisation.SetATrackForDetection:
		IF SUCCEEDED(_MyXtsHardware.SetATrackForDetection(1)) THEN
			Base_Library.Tracing.Trace.Verbose(Source := _name, Message := 'Track 1 set for detection');
			XtsHwState := XtsSystemInitialisation.TriggeringRedetection;
		END_IF
		
	XtsSystemInitialisation.TriggeringRedetection:
		Base_Library.Tracing.Trace.Verbose(Source := _name, Message := 'Mover Redetection Started');
		IF SUCCEEDED(_MyXtsHardware.TriggerMoverRedetection()) THEN
			XtsHwState := XtsSystemInitialisation.WaitingForAllMoversValid;
		END_IF
		
	XtsSystemInitialisation.WaitingForAllMoversValid:
		IF _MyXtsHardware.AllMoverPositionsValid THEN
			Base_Library.Tracing.Trace.Verbose(Source := _name, Message := 'All Movers Valid');
			XtsHwState := XtsSystemInitialisation.CheckingAllMoverFound;
		END_IF
	
	XtsSystemInitialisation.CheckingAllMoverFound:
		IF _MyXtsHardware.AreExpectedMoversFound() THEN
			Base_Library.Tracing.Trace.Verbose(Source := _name, Message := 'Configured Movers = Detected Movers');
			DetectedMoverCount := _MyXtsHardware.NumberOfMoversDetected;
			XtsHwState := XtsSystemInitialisation.CheckIfXtsInSimMode;
		END_IF
		
	XtsSystemInitialisation.CheckIfXtsInSimMode:
		IF _MyXtsHardware.XtsInSim THEN
			XtsHwState := XtsSystemInitialisation.TriggeringMoverIdDetection;
		ELSE
			XtsHwState := XtsSystemInitialisation.CheckingXts24And48Volts;
		END_IF
		
	XtsSystemInitialisation.CheckingXts24And48Volts:
		IF SUCCEEDED(_MyXtsHardware.IsHardware24VdcOK()) AND SUCCEEDED(_MyXtsHardware.IsHardware48VdcOK()) THEN
			XtsHwState := XtsSystemInitialisation.TriggeringMoverIdDetection;
		END_IF
	
	XtsSystemInitialisation.TriggeringMoverIdDetection:
		IF _MyXtsHardware.IsIDDetectionStandard() OR_ELSE SUCCEEDED(_MyXtsHardware.TriggerMoverIDDetection()) THEN
			Base_Library.Tracing.Trace.Verbose(Source := _name, Message := 'Mover ID Detection Complete');
			XtsHwState := XtsSystemInitialisation.XtsInitialised;
		END_IF
	
	XtsSystemInitialisation.XtsInitialised:
		Initialise := 0;
		_Initialised := TRUE;	
END_CASE]]></ST>
      </Implementation>
    </Method>
