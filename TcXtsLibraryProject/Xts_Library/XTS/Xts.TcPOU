    <Method Name="Initialise" Id="{3c52ae7d-89c5-4979-a1bd-5023a279947c}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD Initialise : HRESULT
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Initialise := -1;
Base_Library.Tracing.Trace.Verbose(Source := _Name, Message := 'Waiting for XTS_UtilityLib');
MyXtsInterfaceProvider.Initialise();
IF iXtsInterfaceProvider.Initialised THEN
	Base_Library.Tracing.Trace.Verbose(Source := _Name, Message := 'XTS_Utility Initiliased');
	iXPU := iXtsInterfaceProvider.GetXPUInterface(XtsXpuNumber);
	Initialise := 0;
	_Initialised := TRUE;	
END_IF	]]></ST>
      </Implementation>
    </Method>
