    <Property Name="MyXts" Id="{b982f888-fcea-49f3-8b85-76339b257fce}" FolderPath="Settings\">
      <Declaration><![CDATA[PROPERTY MyXts : INT]]></Declaration>
      <Get Name="Get" Id="{7260ae55-6d72-4286-9779-c205f4bf658b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[MyXts := _MyXtsHardware.MyXts;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{f9bbe24a-eac8-4b47-a949-a650212b0818}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_MyXtsHardware.MyXts := _MyXts := MyXts;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="RegisterMovers" Id="{a3bbc877-121f-4130-8916-a04d2ba4dd9d}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD RegisterMovers : HRESULT
VAR_INPUT
	MyMover : I_XtsMover;
END_VAR
VAR
	i : UINT;
	MoverRegistered: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF MyMover = 0 THEN
	Base_Library.Tracing.Trace.Warning(_name, 'Register Mover Fail - null ptr');
	RegisterMovers := -1;
	RETURN;
END_IF
IF NOT _Initialised THEN
	Base_Library.Tracing.Trace.Warning(_name, 'Register Mover Fail - not ready');
	RegisterMovers := -2;
	RETURN;
END_IF
IF _registeredNumberOfMovers >= TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu THEN
	Base_Library.Tracing.Trace.Warning(_name, 'Register Mover Fail - max movers reached');
	RegisterMovers := -3;
	RETURN;
END_IF
FOR i := 0 TO (_registeredNumberOfMovers - 1) DO
	IF iMovers[i] = MyMover THEN
		MoverRegistered := TRUE;
		EXIT;
	END_IF
END_FOR
IF MoverRegistered THEN
	Base_Library.Tracing.Trace.Warning(_name, 'Register Mover Fail - registered');
	RegisterMovers := -4;
	RETURN;
END_IF

Base_Library.Tracing.Trace.Verbose(_name, 'Register Mover Accepted');
iMovers[_registeredNumberOfMovers] := MyMover;
_registeredNumberOfMovers := _registeredNumberOfMovers + 1;
EnableSequence.RegisterMovers(MyMover);
DisableSequence.RegisterMovers(MyMover);
FOR i := 1 TO _MyXtsHardware.DetectedNumberOfTracks DO
	MyMover.RegisterTracks(Track := _MyXtsHardware.GetTrackInterfaceByNumber(i));
END_FOR
FOR i := 1 TO TO_UINT(_iXPU.GetDetectedMoverCount()) DO
	IF MyMover.AxisRef.NcToPlc.AxisId = _iXPU.MoverTcIo(i).P_AxisId THEN
		MyMover.MoverXtsIoEnvInterface := _iXPU.MoverTcIo(i);
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterWithParent" Id="{5a27c335-0022-4ddf-98ff-1436953bbdbd}">
      <Declaration><![CDATA[METHOD RegisterWithParent
VAR_INPUT
	Parent	: I_HostObjects;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Parent.RegisterCyclic(THIS^);
Parent.RegisterInitialisable(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{f4cda3e0-308c-460d-87ee-c1616441d1b6}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD Reset : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Initialised THEN
	Reset := -1;
	RETURN;
END_IF

ResetTrigger.CLK := TRUE;
Base_Library.Tracing.Trace.Verbose(_Name, 'Reset Accepted');]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetSequence" Id="{13cd689a-6bb1-4c04-93f3-31d6703e31bf}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD ResetSequence : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE ResetState OF
	XtsResetState.Idle:
		IF ResetTrigger.Q THEN
			ResetState := XtsResetState.ResettingHardware;
			_iXPU.TriggerResetAllParts();
		END_IF	
	XtsResetState.ResettingHardware:
		IF NOT HardwareError THEN
			ICollisionGroup.Reset();
			ResetState := XtsResetState.ResettingCAGroup;
		END_IF
	XtsResetState.ResettingCAGroup:
		IF NOT iCollisionGroup.HasError THEN
			ResetState := XtsResetState.Done;
		END_IF
	XtsResetState.Done:
		ResetTrigger.CLK := FALSE;
		ResetState := XtsResetState.Idle;
END_CASE
ResetTrigger();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StopXts" Id="{4b648283-f5f4-4d47-a58f-be53e519365d}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD StopXts : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[StopXTS := ICollisionGroup.GroupStop();
Base_Library.Tracing.Trace.Verbose(_name, 'Stop Accepted');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>