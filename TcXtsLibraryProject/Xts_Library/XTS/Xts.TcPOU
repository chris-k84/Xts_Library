<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Xts" Id="{4538c683-94fc-49a1-b5ad-30ffec5e4eff}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT XTS EXTENDS CyclicBase IMPLEMENTS I_Initialisable, I_XTS
VAR
	// Status Flags
	_MyXts : INT;
	_XtsEnabled : BOOL;
	_InSim : BOOL;
	Initialising : BOOL;
	_Initialised : BOOL;
	DetectedMoverCount : UDINT;
	HardwareError : BOOL;
	CAGroupError : BOOL;
	_ErrorID : UDINT;
	XtsHwState : XtsSystemInitialisation;
	XtsOperatingMode : OperationMode;
	
	// XTS Components
	_XtsIoEnvVar : I_XtsIoEnvVar;
	_iXPU : I_TcIoXtsProcessingUnit;
	iMovers : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF I_XtsMover;
	_MyXtsHardware : I_XtsHardware;
	ICollisionGroup : I_CollisionGroup;
	
	// Behaviours
	EnableSequence : XtsEnableSequence;
	DisableSequence : XtsDisableSequence;	
	EnabledTrigger : R_TRIG;
	DisabledTrigger : R_TRIG;
	ResetTrigger : R_TRIG;
	ResetState : XtsResetState;
	_registeredNumberOfMovers: INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[{analysis -2}]]></ST>
    </Implementation>
    <Folder Name="Operations" Id="{0e8598c4-3d58-4c14-a12f-6fd3f3ea02bf}" />
    <Folder Name="Private" Id="{3792690f-dbde-4d97-aae6-86812312ba25}" />
    <Folder Name="Settings" Id="{cec05bdb-9232-4b5d-b91e-848bd7bc55d9}" />
    <Folder Name="Status" Id="{c34f5481-c408-4671-a299-9c4a6e31956c}" />
    <Method Name="AreAllMoversStationary" Id="{f009ccd3-c388-424a-b98d-ae435064fa0b}" FolderPath="Status\">
      <Declaration><![CDATA[METHOD AreAllMoversStationary : BOOL
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AreAllMoversStationary := TRUE;
FOR i := 0 TO _registeredNumberOfMovers - 1 DO
	IF NOT iMovers[i].IsStationary THEN
		AreAllMoversStationary := FALSE;
		EXIT;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cycle" Id="{da42838e-fb00-40a5-96f4-b787aa883566}">
      <Declaration><![CDATA[METHOD PUBLIC Cycle : HRESULT
VAR
	EnableResult : HRESULT;
	DisableResult : HRESULT;
	GrpStopResult : HRESULT;
	CollisionResult : HRESULT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Initialised THEN	
	Cycle  := -1;
	RETURN;
END_IF

EnableResult := EnableSequence.Cycle();
DisableResult := DisableSequence.Cycle();
EnabledTrigger(CLK := EnableSequence.Done);
DisabledTrigger(CLK := DisableSequence.Done);
IF EnabledTrigger.Q THEN
	_XtsEnabled := TRUE;
END_IF
IF DisabledTrigger.Q THEN
	_XtsEnabled := FALSE;
END_IF

ResetSequence();
CAGroupError := ICollisionGroup.HasError;
HardwareError := (_iXPU.GetDriveState() = (DriveState.Fault OR DriveState.FaultReactionActive)) OR _MyXtsHardware.AnyPartsInError;


IF CAGroupError THEN
	_ErrorID := ICollisionGroup.ErrorCode;
END_IF

IF NOT CAGroupError AND NOT HardwareError THEN
	_ErrorID := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DisableXTS" Id="{e2a85e5a-c7bf-481d-be4f-81acebc29fb7}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD DisableXTS : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _XtsEnabled THEN
	RETURN;
END_IF

IF SUCCEEDED(DisableSequence.Disable()) THEN	
	Base_Library.Tracing.Trace.Verbose(_name, 'Disable Accepted');
	DisableXTS := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="EnableXTS" Id="{e800781e-1435-4747-9cb4-9b9fab34ca22}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD EnableXTS : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _XtsEnabled THEN
	RETURN;
END_IF

IF SUCCEEDED(EnableSequence.Enable()) THEN
	Base_Library.Tracing.Trace.Verbose(_name, 'Enable Accepted');
	EnableXts := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
