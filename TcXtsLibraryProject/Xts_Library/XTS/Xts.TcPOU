<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Xts" Id="{4538c683-94fc-49a1-b5ad-30ffec5e4eff}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Xts 
VAR_GENERIC CONSTANT
    NumberOfParts  : UINT := 1;
	NumberOfTracks : UINT := 1;
	NumberOfModules : UINT := 1;
	XtsXpuNumber : UINT := 1;
	NumberOfMovers : UINT := 1;
END_VAR
EXTENDS CyclicBase IMPLEMENTS I_Initialisable, I_XTS, I_Object
VAR
	_XtsEnabled : BOOL;
	_InSim : BOOL;
	iXPU : I_TcIoXtsProcessingUnit;
	MoverArray : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF XtsMover('');
	_iMoverArray : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsMoversPerXpu] OF I_XtsMover;
	DefaultMoverDetectionAlgorithm : StandardMoverDetection;
	iMoverDetectionAlogrithm : I_MoverDetectionAlgorithm := DefaultMoverDetectionAlgorithm;
	MyXtsInterfaceProvider : XtsInterfaceProvider;
	iXtsInterfaceProvider : I_XtsInterfaceProvider := MyXtsInterfaceProvider;
	myCAGroup : CollisionGroup;
	iCollisionGroup : I_CollisionGroup := myCAGroup;
	EnableSequence : XtsEnableSequence := (MyCollisionGroup := iCollisionGroup);
	DisableSequence : XtsDisableSequence := (MyCollisionGroup := iCollisionGroup);	
	_Initialised : BOOL;
	_HardwareDiscoveryComplete : BOOL;
	EnabledTrigger : R_TRIG;
	DisabledTrigger : R_TRIG;
	HardwareError : BOOL;
	CAGroupError : BOOL;
	_ErrorID : UDINT;
	Modules : ARRAY[0..MaxModules] OF XtsMotorModule('');
	iModules : ARRAY[0..MaxModules] OF i_XtsMotorModule;
	XtsParts : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxPartsPerTrack] OF XtsPart('');
	iXtsParts : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxPartsPerTrack] OF I_XtsPart;
	XtsTracks : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsTracksPerXpu] OF XtsTrack('');
	iXtsTracks : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxXtsTracksPerXpu] OF I_XtsTrack;
	MyPartCount: UDINT;
	MyTrackCount: UDINT;
	MyModuleCount : UDINT;
	MyMoverCount : UDINT;
	HardwareDiscoveryState: XtsHardwareDiscoveryState;
END_VAR
VAR CONSTANT
	MaxModules : UINT := 1000;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[{analysis -2}]]></ST>
    </Implementation>
    <Folder Name="Operations" Id="{0e8598c4-3d58-4c14-a12f-6fd3f3ea02bf}" />
    <Folder Name="Private" Id="{3792690f-dbde-4d97-aae6-86812312ba25}" />
    <Folder Name="Settings" Id="{cec05bdb-9232-4b5d-b91e-848bd7bc55d9}" />
    <Folder Name="Status" Id="{c34f5481-c408-4671-a299-9c4a6e31956c}" />
    <Method Name="AreAllMoversStationary" Id="{f009ccd3-c388-424a-b98d-ae435064fa0b}" FolderPath="Status\">
      <Declaration><![CDATA[METHOD AreAllMoversStationary : BOOL
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AreAllMoversStationary := TRUE;
FOR i := 0 TO TO_INT(MyMoverCount) - 1 DO
	IF NOT _iMoverArray[i].IsStationary THEN
		AreAllMoversStationary := FALSE;
		EXIT;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckPartsForError" Id="{8aa34e06-0102-41ed-a3cf-341e27edd24f}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE CheckPartsForError : BOOL
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckPartsForError := FALSE;
FOR i := 0 TO TO_INT(MyPartCount - 1) DO
	IF iXtsParts[i] <> 0 AND_THEN iXtsParts[i].HasError THEN
		CheckPartsForError := TRUE;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cycle" Id="{da42838e-fb00-40a5-96f4-b787aa883566}">
      <Declaration><![CDATA[METHOD PUBLIC Cycle : HRESULT
VAR
	EnableResult : HRESULT;
	DisableResult : HRESULT;
	GrpStopResult : HRESULT;
	CollisionResult : HRESULT;
	i : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Initialised THEN	
	Cycle  := -1;
	RETURN;
END_IF

IF NOT _HardwareDiscoveryComplete THEN
	Cycle := -2;
	RETURN;
END_IF

iMoverDetectionAlogrithm.Cycle();
EnableResult := EnableSequence.Cycle();
DisableResult := DisableSequence.Cycle();
myCAGroup.Cycle();
EnabledTrigger(CLK := EnableSequence.Done);
DisabledTrigger(CLK := DisableSequence.Done);
IF EnabledTrigger.Q THEN
	_XtsEnabled := TRUE;
END_IF
IF DisabledTrigger.Q THEN
	_XtsEnabled := FALSE;
END_IF

HardwareError := iXPU.GetDriveState() = DriveState.Fault OR CheckPartsForError();
CAGroupError := ICollisionGroup.HasError;

IF CAGroupError THEN
	_ErrorID := ICollisionGroup.ErrorCode;
END_IF

IF NOT CAGroupError AND NOT HardwareError THEN
	_ErrorID := 0;
END_IF

IF MyModuleCount <> 0 THEN
	FOR i := 0 TO MyModuleCount - 1 DO
		Modules[i].Cycle();
	END_FOR
END_IF
IF MyPartCount <> 0 THEN
	FOR i := 0 TO MyPartCount - 1 DO
		XtsParts[i].Cycle();
	END_FOR
END_IF
IF MyTrackCount <> 0 THEN
	FOR i := 0 TO MyTrackCount - 1 DO
		XtsTracks[i].Cycle();
	END_FOR
END_IF

IF MyMoverCount <> 0 THEN
	FOR i := 0 TO MyMoverCount - 1 DO
		MoverArray[i].Cycle();
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DisableXTS" Id="{e2a85e5a-c7bf-481d-be4f-81acebc29fb7}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD DisableXTS : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _XtsEnabled THEN
	Base_Library.Tracing.Trace.Verbose(_Name, 'Disable Accepted');
	DisableXTS := SUCCEEDED(DisableSequence.Disable());
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="DiscoverHardware" Id="{199dc34b-920a-40a0-b86e-d4d30a9fd81a}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD PROTECTED DiscoverHardware : HRESULT
VAR
	i,j : INT;
	allInitialised : BOOL;
	ModuleCount : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[DiscoverHardware := -1;
CASE HardwareDiscoveryState OF
	XtsHardwareDiscoveryState.WaitingForXpu:
		IF NOT _Initialised THEN
			RETURN;
		ELSE
			Base_Library.Tracing.Trace.Verbose(Source := _Name, Message := 'Starting Hardware Discovery');
			HardwareDiscoveryState := XtsHardwareDiscoveryState.GettingParts;
		END_IF 
	XtsHardwareDiscoveryState.GettingParts:
		Base_Library.Tracing.Trace.Verbose(Source := _Name, Message := 'Running Part Discovery');
		MyPartCount := iXPU.P_PartCount;
		IF TO_INT(MyPartCount) = NumberOfParts THEN
			FOR i := 0 TO (TO_INT(MyPartCount) - 1) DO
				XtsParts[i].SetXtsIoPartInterface(iXPU.PartTcIo(TO_UINT(i + 1)));
				IXtsParts[i] := XtsParts[i];
				IF iXPU.GetOperationMode() = OperationMode.Simulation THEN
					_InSim := TRUE;
				END_IF
			END_FOR
			HardwareDiscoveryState := XtsHardwareDiscoveryState.InitialisingXtsParts;
		ELSE
			Base_Library.Tracing.Trace.Error(Source := _Name, Message := 'Part count does not match detected part count');
			HardwareDiscoveryState := XtsHardwareDiscoveryState.DiscoveryFault;
		END_IF
	XtsHardwareDiscoveryState.InitialisingXtsParts:
		allInitialised := TRUE;
		FOR i := 0 TO UDINT_TO_INT(MyPartCount - 1) DO
			IF FAILED(XtsParts[i].Initialise()) THEN
				allInitialised := FALSE;
			END_IF
		END_FOR
		IF allInitialised THEN
			HardwareDiscoveryState := XtsHardwareDiscoveryState.GettingTracks;
		END_IF
	XtsHardwareDiscoveryState.GettingTracks:
		Base_Library.Tracing.Trace.Verbose(Source := _Name, Message := 'Running Track Discovery');
		MyTrackCount := iXPU.P_TrackCount;
		IF TO_INT(MyTrackCount) = NumberOfTracks THEN
			FOR i := 0 TO UDINT_TO_INT(MyTrackCount - 1) DO
				XtsTracks[i].SetXtsIoTrackInterface(iXPU.TrackTcIo(TO_UINT(i + 1)));
				IXtsTracks[i] := XtsTracks[i];
			END_FOR
			HardwareDiscoveryState := XtsHardwareDiscoveryState.InitialisingXtsTracks;
		ELSE
			Base_Library.Tracing.Trace.Error(Source := _Name, Message := 'Track count does not match detected part count');
			HardwareDiscoveryState := XtsHardwareDiscoveryState.DiscoveryFault;
		END_IF
	XtsHardwareDiscoveryState.InitialisingXtsTracks:
		allInitialised := TRUE;
		FOR i := 0 TO UDINT_TO_INT(MyTrackCount - 1) DO
			IF FAILED(XtsTracks[i].Initialise()) THEN
				allInitialised := FALSE;
			END_IF
		END_FOR
		IF allInitialised THEN
			HardwareDiscoveryState := XtsHardwareDiscoveryState.GettingModules;
		END_IF
	XtsHardwareDiscoveryState.GettingModules:
			FOR i := 0 TO (TO_INT(MyPartCount) - 1) DO
				ModuleCount := iXPU.PartTcIo(TO_UINT(i + 1)).P_ModuleCount;
				FOR j := 0 TO (TO_INT(ModuleCount)-1) DO
					Modules[MyModuleCount].SetXtsIoModuleInterface(iXPU.PartTcIo(TO_UINT(i + 1)).ModuleTcIo(TO_UINT(j + 1)));
					iModules[MyModuleCount] := Modules[MyModuleCount];
					XtsParts[i].SetModuleInPArt(iModules[MyModuleCount]);
					MyModuleCount := MyModuleCount + 1;
				END_FOR
			END_FOR
			HardwareDiscoveryState := XtsHardwareDiscoveryState.InitialisingModules;
	XtsHardwareDiscoveryState.InitialisingModules:
		allInitialised := TRUE;
		FOR i := 0 TO TO_INT(MyModuleCount - 1) DO
			IF FAILED(Modules[i].Initialise()) THEN
				allInitialised := FALSE;
			END_IF
		END_FOR
		IF allInitialised THEN
			HardwareDiscoveryState := XtsHardwareDiscoveryState.HardwareFound;
		END_IF
	XtsHardwareDiscoveryState.GettingMovers:
		MyMoverCount := iXPU.P_MoverCount;
		IF MyMoverCount = NumberOfMovers THEN
			FOR i := 0 TO (TO_INT(MyMoverCount) - 1) DO
				MoverArray[i].SetXtsIoMoverInterface(iXPU.MoverTcIo(TO_UINT(i + 1)));
				_iMoverArray[i] := MoverArray[i];
			END_FOR
			HardwareDiscoveryState := XtsHardwareDiscoveryState.InitialisingMovers;
		ELSE
			Base_Library.Tracing.Trace.Error(Source := _Name, Message := 'Mover count does not match detected Mover count');
			HardwareDiscoveryState := XtsHardwareDiscoveryState.DiscoveryFault;
		END_IF
	XtsHardwareDiscoveryState.InitialisingMovers:
		allInitialised := TRUE;
		FOR i := 0 TO TO_INT(MyMoverCount - 1) DO
			IF FAILED(moverarray[i].Initialise()) THEN
				allInitialised := FALSE;
			END_IF
		END_FOR
		IF allInitialised THEN
			HardwareDiscoveryState := XtsHardwareDiscoveryState.HardwareFound;
		END_IF
	
	XtsHardwareDiscoveryState.HardwareFound:
		Base_Library.Tracing.Trace.Verbose(Source := _Name, Message := 'Hardware Discovery Complete');
		_HardwareDiscoveryComplete := TRUE;
		DiscoverHardware := 0;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="EnableXTS" Id="{e800781e-1435-4747-9cb4-9b9fab34ca22}" FolderPath="Operations\">
      <Declaration><![CDATA[METHOD EnableXTS : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _XtsEnabled THEN
	Base_Library.Tracing.Trace.Verbose(_Name, 'Enable Accepted');
	EnableXts := SUCCEEDED(EnableSequence.Enable());
END_IF]]></ST>
      </Implementation>
    </Method>
