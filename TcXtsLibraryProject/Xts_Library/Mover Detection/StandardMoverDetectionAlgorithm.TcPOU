	  </Get>
	</Property>

	<Property Name="StatusMessage" Id="{z8a9b0c1-d2e3-4x4f-g5h6-i7j8k9l0m1n2}" FolderPath="Status\">
	  <Declaration><![CDATA[PROPERTY PUBLIC StatusMessage : T_MaxString]]></Declaration>
	  <Get Name="Get" Id="{a9b0c1d2-e3f4-4y5g-h6i7-j8k9l0m1n2o3}">
		<Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
		<Implementation>
		  <ST><![CDATA[StatusMessage := _StatusMessage;
]]></ST>
		</Implementation>
	  </Get>
	</Property>

	<!-- PRIVATE METHODS -->

	<Method Name="TriggerMoverIdDetectionInternal" Id="{b0c1d2e3-f4g5-4z6h-i7j8-k9l0m1n2o3p4}" FolderPath="Private\">
	  <Declaration><![CDATA[METHOD PRIVATE TriggerMoverIdDetectionInternal : HRESULT
]]></Declaration>
	  <Implementation>
		<ST><![CDATA[_MoverIdDetectionError := _MoverIdDetectionState = MoverIdDetectionStateEnum.Error;
_MoverIdDetected := _MoverIdDetectionState = MoverIdDetectionStateEnum.Valid;
_MoverIdDetectionState := _iXPU.GetMoverIdDetectionState();

IF _iXPU.GetMoverIdDetectionMode() = MoverIdDetectionMode.Standard THEN
  TriggerMoverIdDetectionInternal := -1;
  RETURN;
END_IF

IF _MoverIdDetectionState = MoverIdDetectionStateEnum.Running THEN
  TriggerMoverIdDetectionInternal := -2;
  RETURN;
END_IF

_iXPU.TriggerMoverIdDetection();
TriggerMoverIdDetectionInternal := S_OK;
]]></ST>
	  </Implementation>
	</Method>

  </POU>
</TcPlcObject>