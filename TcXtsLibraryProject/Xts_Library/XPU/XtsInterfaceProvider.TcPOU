<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsInterfaceProvider" Id="{03c3c931-6ee3-4ab9-88b9-320f3e1d8e15}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsInterfaceProvider IMPLEMENTS I_XtsInterfaceProvider, I_Object, I_Initialisable
VAR
	XtsIoEnvironment : Tc3_XTS_Utility.FB_TcIoXtsEnvironment;
	stXtsEnvironmentConfiguration	: ST_XtsEnvironmentConfiguration;
	_Initialised : BOOL;
	cagroupcount: BOOL;
	paramsetcount: UINT;
	infoservercount: UINT;
	xpucount: UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Commands" Id="{3a159131-d61b-452b-8e2f-6ee920e4571d}" />
    <Folder Name="Status" Id="{11c58542-69d8-416b-8e98-b88ed835287f}" />
    <Method Name="FB_init" Id="{5798f5d6-785a-4124-98b0-b4ab031dfdac}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stXtsEnvironmentConfiguration.bEnableInitCaGroup := TRUE;
XtsIoEnvironment.P_XtsEnvironmentConfiguration := stXtsEnvironmentConfiguration;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetCaGroupInterface" Id="{12f834a0-9ae6-48b5-9bae-7bc717cd2b2d}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD GetCaGroupInterface : I_Mc2CaGroup
VAR_INPUT
	CAGroupNumber : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialised THEN
	RETURN;
END_IF

GetCaGroupInterface := XtsIoEnvironment.Mc2CaGroup(TO_UINT(CAGroupNumber));]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetModuleInterface" Id="{9e8a4fd0-ade8-4386-8b86-2a458cce9585}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD GetModuleInterface : I_TcIoXtsPartModule
VAR_INPUT
	MyXts : INT;
	Part : INT;
	Module : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[XtsIoEnvironment.XpuTcIo(TO_UINT(MyXts)).PartTcIo(Part).ModuleTcIo(Module);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetMoverInterface" Id="{3c22037c-a890-4771-941e-6c3b9baf32f6}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD GetMoverInterface : I_TcIoXtsXpuMover
VAR_INPUT
	MyXts : INT;
	Mover : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialised THEN
	RETURN;
END_IF
GetMoverInterface := XtsIoEnvironment.XpuTcIo(TO_UINT(MyXts)).MoverTcIo(Mover);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetPartInterface" Id="{f8a0e0e3-0f08-4154-a007-a3b6ddf4a82b}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD GetPartInterface : I_TcIoXtsXpuPart
VAR_INPUT
	MyXts : INT;
	Part : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialised THEN
	RETURN;
END_IF
GetPartInterface := XtsIoEnvironment.XpuTcIo(TO_UINT(MyXts)).PartTcIo(Part);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetTrackInterface" Id="{458a2926-08f7-48fe-9ad8-86ada7442d2d}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD GetTrackInterface : I_TcIoXtsXpuTrack
VAR_INPUT
	MyXts : INT;
	Track : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialised THEN
	RETURN;
END_IF

GetTrackInterface := XtsIoEnvironment.XpuTcIo(TO_UINT(MyXts)).TrackTcIo(Track);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetXPUInterface" Id="{a6b4198a-d372-4fc0-b700-debb44563dc0}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD GetXPUInterface : I_TcIoXtsProcessingUnit
VAR_INPUT
	MyXts : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialised THEN
	RETURN;
END_IF

GetXPUInterface := XtsIoEnvironment.XpuTcIo(TO_UINT(MyXts));]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialise" Id="{f0d17991-21f7-403c-899a-0fcccbff041e}">
      <Declaration><![CDATA[METHOD PUBLIC Initialise : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT 	Initialising THEN
	Initialising := TRUE;
	Base_Library.Tracing.Trace.Info(Source := 'XTS Utility Library', Message := 'Waiting for XTS_UtilityLib');
END_IF

IF XtsIoEnvironment.Init(TRUE) THEN
	XtsIoEnvironment.Init(FALSE);
	_Initialised := TRUE;
	//cagroupcount := XtsIoEnvironment.GetCaGroupCount(TRUE);
//XtsIoEnvironment.P_CaGroupOids;
	paramsetcount := XtsIoEnvironment.P_ParameterSetCount;
	infoservercount := XtsIoEnvironment.P_InfoServerCount;
	xpucount := XtsIoEnvironment.P_XpuCountUint;
ELSE
	Initialise := -1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialised" Id="{0f4a9fc3-49d6-473e-a6e3-78db8cfcf818}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY Initialised : BOOL]]></Declaration>
      <Get Name="Get" Id="{820b3227-250d-444d-bfaf-048041bb942e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialised := _Initialised;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RegisterWithParent" Id="{37203846-0f41-471d-b37e-9d946dd0bd38}">
      <Declaration><![CDATA[METHOD RegisterWithParent
VAR_INPUT
	Parent	: I_HostObjects;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Parent.RegisterInitialisable(THIS^);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>