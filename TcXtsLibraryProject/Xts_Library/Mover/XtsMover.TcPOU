      </Get>
      <Set Name="Set" Id="{aede2ad8-809d-4697-b667-b49152253954}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ForwardOnly := PositiveDirectionOnly;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Reset" Id="{e9d8249c-2f88-4980-a483-ceda82c7ab80}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD PUBLIC Reset : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ResetBehaviour.Busy THEN
	Base_Library.Tracing.Trace.Warning(_Name, 'Reset Request Failed - Reseting');
	Reset := -1;
	RETURN;
END_IF
 
IF NOT (_MyAxisStatus.Error OR _MyAxisStatus.NotMoving) THEN
	Base_Library.Tracing.Trace.Warning(_Name, 'Reset Request Failed - Not Allowed');
	Reset := -2;
	RETURN;
END_IF

Base_Library.Tracing.Trace.Verbose(_Name, 'Reset Request Accepted');
ResetBehaviour.Reset();
MoveBehaviour.Abort();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetForceCouple" Id="{655fe1cd-78c7-4097-b5c7-b05e68cd5f7e}" FolderPath="Administration\">
      <Declaration><![CDATA[METHOD SetForceCouple : HRESULT
VAR_INPUT
	XtsMoverCtrlOTCID : Tc3_XTS_Utility.XtsMoverControllerOTCID;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	SetForceCouple := - 1;
	RETURN;
END_IF

_MyInterface.MoverController.SetForceCouple(nForceCouple := XtsMoverCtrlOTCID);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMoverActiveTrack" Id="{d6a4b78b-2758-4ca3-91dd-004aef96a776}" FolderPath="Administration\">
      <Declaration><![CDATA[METHOD SetMoverActiveTrack : HRESULT
VAR_INPUT
	Track : OTCID;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Track = 0 THEN
	SetMoverActiveTrack := -1;
	RETURN;
END_IF

IF NOT THIS^.IsStationary THEN
	SetMoverActiveTrack := -3;
	RETURN;
END_IF
	
_MyInterface.SetActiveTrackObjectId(nTrackObjectId := Track);
_CurrentTrack := Track;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetParameterSet" Id="{a2d3312c-642a-4ded-95b4-a250a99284ac}" FolderPath="Administration\">
      <Declaration><![CDATA[METHOD SetParameterSet : HRESULT
VAR_INPUT
	ParameterSet : OTCID;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ParameterSet = 0 THEN
	RETURN;
	SetParameterSet := -1;
END_IF

myController.SetDefaultParameterSet(ParameterSet);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetSimDetectionPartAndPosition" Id="{7c9e452d-fc91-446a-83ce-0915a34e15cf}" FolderPath="Administration\">
      <Declaration><![CDATA[METHOD SetSimDetectionPartAndPosition : BOOL
VAR_INPUT
	Part : OTCID;
	Position : LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MyInterface.SetSimulatedStartUpPart(Part);
_MyInterface.SetSimulatedStartUpPosition(Position);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetXtsIoMoverInterface" Id="{6e9b4848-4a92-448f-8f39-57970843623a}" FolderPath="Settings\">
      <Declaration><![CDATA[METHOD SetXtsIoMoverInterface : HRESULT
VAR_INPUT
	MoverInterface : I_TcIoXtsXpuMover;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF MoverInterface = 0 THEN
	SetXtsIoMoverInterface := -1;
	Base_Library.Tracing.Trace.Error(_name, 'XPU interface not assigned');
	RETURN;
END_IF


_MyInterface := MoverInterface;
_Name := _MyInterface.P_ObjectName;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Status" Id="{7210093a-6aaa-412a-b61c-1cd78f6b0715}" FolderPath="Status\">
      <Declaration><![CDATA[PROPERTY Status : MoverStatus]]></Declaration>
      <Get Name="Get" Id="{e48e107d-404f-4b57-801c-c1bdf333ce6b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Status := _myStatus;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SwapMover" Id="{075d081f-a4ad-470f-95aa-ced1f28cc5a8}" FolderPath="Administration\">
      <Declaration><![CDATA[METHOD SwapMover : HRESULT
VAR_INPUT
    MoverToSwapWith : MoverOTCID;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MyInterface.swapmover(nSwapMoverObjectId := MoverToSwapWith);
]]></ST>
      </Implementation>
