    <Method Name="Cycle" Id="{b5956233-12ba-4cb8-805f-5693aec42bed}">
      <Declaration><![CDATA[METHOD PUBLIC  Cycle : HRESULT
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Initialised THEN
	TaskCollection.Cycle();
	TrackChangeTrigger(CLK := MoverActivateTrackBehaviour.Done);
	IF TrackChangeTrigger.Q THEN
		_MoverAbsMoveOptions.PositionReferenceSystem :=  MoverActivateTrackBehaviour.NewTrackId;
		_MoverAbsMoveOptions.DynamicsReferenceSystem := MoverActivateTrackBehaviour.NewTrackId;
		MoveBehaviour.Options := _MoverAbsMoveOptions;	
	END_IF
	IF _MyInterface <> 0 THEN
		_stTmsActPositions := _MyInterface.GetPositionInfo();
		_SetForce := _MyInterface.GetSetForce();
		_SetCurrent := _MyInterface.GetSetCurrent();
		_myStatus.isMover1 := _MyInterface.GetIsMover1();
		_myStatus.isActive := _MyInterface.GetIsActive();
		_myStatus.isFrozen := _MyInterface.GetIsFrozen();
		_myStatus.isLost := _MyInterface.GetIsLost();
		_myStatus.isReadyForPositioning := _MyInterface.GetIsReadyForPositioning();
		_myStatus.hasControllerError := _MyInterface.GetMoverControllerError();
		_myStatus.driveState := _MyInterface.GetDriveStatus();
		_DistanceDrivenInMM := _MyInterface.GetDistanceDriven();
	END_IF
	_AvoidingCollision := MyAxisRef.NcToPlc.StateDWord2.Flags.AvoidingCollision;
ELSE
	Cycle := -1;
END_IF
MyAxisRef.ReadStatus();
_MyNCData := MyAxisRef.NcToPlc;
_MyAxisStatus := MyAxisRef.Status;]]></ST>
      </Implementation>
    </Method>
