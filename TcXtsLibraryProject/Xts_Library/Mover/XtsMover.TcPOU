    <Method Name="ActivateTrack" Id="{f7604675-5338-4e11-9132-b17d5df72cc8}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD ActivateTrack : HRESULT
VAR_INPUT
	Track : OTCID;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Track = 0 THEN
	ActivateTrack := -1;
	Base_Library.Tracing.Trace.Warning(_Name, 'ActivateTrack Fail - Null Track');
	RETURN;
END_IF
IF MoverActivateTrackBehaviour.Busy THEN
	ActivateTrack := -2;
	Base_Library.Tracing.Trace.Warning(_Name, 'ActivateTrack Fail - Activating');
	RETURN;
END_IF

IF NOT THIS^.IsStationary THEN
	ActivateTrack := -3;
	Base_Library.Tracing.Trace.Warning(_Name, 'ActivateTrack Fail - Moving');
	RETURN;
END_IF

	
Base_Library.Tracing.Trace.Verbose(_Name, 'ActivateTrack Request Accepted');
MoverActivateTrackBehaviour.Execute(Track := Track);
_MyInterface.SetActiveTrackObjectId(nTrackObjectId := Track);
_CurrentTrack := Track;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ActivateZeroReferenceSystem" Id="{f593e12a-c440-483d-8309-49c5dc48d5f1}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD ActivateZeroReferenceSystem : HRESULT]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF MoverActivateTrackBehaviour.Busy THEN
	ActivateZeroReferenceSystem := -1;
	Base_Library.Tracing.Trace.Warning(_Name, 'ActivateZeroTrack Fail - Activating');
	RETURN;
END_IF
IF NOT THIS^.IsStationary THEN
	ActivateZeroReferenceSystem := -2;
	Base_Library.Tracing.Trace.Warning(_Name, 'ActivateZeroTrack Fail - Moving');
	RETURN;
END_IF 

Base_Library.Tracing.Trace.Verbose(_Name, 'ActivateTrack Request Accpeted');
MoverActivateTrackBehaviour.Execute(Track := 0);
_CurrentTrack := 0;]]></ST>
      </Implementation>
    </Method>
