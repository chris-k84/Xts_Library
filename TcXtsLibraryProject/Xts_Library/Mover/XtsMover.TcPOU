    <Method Name="Initialise" Id="{158eaadb-7779-40c3-b4d7-ef64750e6b36}">
      <Declaration><![CDATA[METHOD Initialise : HRESULT
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Initialised THEN
	Base_Library.Tracing.Trace.Error(_Name, 'Mover Already Initialised');
	Initialise := -1;
	RETURN;
END_IF

IF _MyInterface = 0 THEN
	Base_Library.Tracing.Trace.Error(_Name, 'No XPU interface for Init');
	Initialise := -2;
	RETURN;
END_IF

IF NOT _MyInterface.P_IsInitialized THEN
	Initialise := -3;
	Base_Library.Tracing.Trace.Error(_Name, 'XPU Interface not ready');
	RETURN;
END_IF

IF MyAxisRef.NcToPlc.AxisId = 0 THEN
	Initialise := -4;
	Base_Library.Tracing.Trace.Error(_Name, 'Mover has no NC link');
	RETURN;
END_IF

Base_Library.Tracing.Trace.Verbose(_Name, 'Mover Init Success');
myController := _MyInterface.MoverController;
myControllerOid := _MyInterface.GetMoverControllerOid();
_Mover1 := _MyInterface.GetIsMover1();
_CurrentTrack := _MyInterface.GetActiveTrackObjectId();

Initialised := TRUE;]]></ST>
      </Implementation>
    </Method>
