    <Method Name="TriggerMoverArrive" Id="{9bb7f072-ab21-4ec2-9434-ad1366cf5fb7}" FolderPath="Administration\">
      <Declaration><![CDATA[METHOD TriggerMoverArrive : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	TriggerMoverArrive := - 1;
	RETURN;
END_IF
IF _myStatus.isActive THEN
	TriggerMoverArrive := - 2;
	RETURN;
END_IF

_MyInterface.TriggerArrive();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TriggerMoverLeave" Id="{074e60e5-1df3-46d8-92fd-930fc05fcb13}" FolderPath="Administration\">
      <Declaration><![CDATA[METHOD TriggerMoverLeave : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _MyInterface = 0 THEN
	TriggerMoverLeave := -1;
	RETURN;
END_IF
IF NOT _myStatus.isActive THEN
	TriggerMoverLeave := -2;
	RETURN;
END_IF
IF NOT IsStationary THEN
	TriggerMoverLeave := -3;
	RETURN;
END_IF

_MyInterface.TriggerLeave();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>