    <Method Name="DisableMover" Id="{a82f95fa-77b4-4c5e-ae67-686dbd3b2d8d}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD PUBLIC DisableMover : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT THIS^.IsEnabled THEN
	DisableMover := -1;
	Base_Library.Tracing.Trace.Warning(_Name, 'Disable request Fail - Disabled'); 
	RETURN;
END_IF
	
Base_Library.Tracing.Trace.Verbose(_Name, 'Disable Request Accepted');
EnableBehaviour.Disable();]]></ST>
      </Implementation>
    </Method>
    <Method Name="EnableMover" Id="{d130fe63-f34a-4455-8bb8-4dfcc482e573}" FolderPath="Commands\">
      <Declaration><![CDATA[METHOD PUBLIC EnableMover : HRESULT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF EnableBehaviour.Busy THEN
	EnableMover := -1;
	Base_Library.Tracing.Trace.Warning(_Name, 'Enable Request Failed - Enabling');
	RETURN;
END_IF
IF THIS^.IsEnabled THEN
	EnableMover := -2;
	Base_Library.Tracing.Trace.Warning(_Name, 'Enable Request Failed - Enabled');
	RETURN;
END_IF
	
Base_Library.Tracing.Trace.Verbose(_Name, 'Enable Request Accepted');
EnableBehaviour.Enable();]]></ST>
      </Implementation>
    </Method>
