<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="StubXts" Id="{59a8f0f1-3a37-4f6e-9e76-a82474ad05c1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK StubXts
VAR_GENERIC CONSTANT
    NuOfParts  : UINT := 1;
	NuOfTracks : UINT := 1;
	NuOfModules : UINT := 1;
	XpuNumber : UINT := 1;
	NuofMovers : UINT := 1;
END_VAR EXTENDS Xts<NuOfParts,NuOfTracks, NuOfModules,XpuNumber,NuofMovers>
VAR
	i : UDINT;
	stubXtsParts : ARRAY[0..TcIoXtsEnvironmentParameterList.MaxPartsPerTrack] OF stubPart;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{231852fe-b03e-4ea0-9051-8a2adf83df1c}">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains	: BOOL;
	(* TRUE: the instance will be copied to the copy code afterward (online change)  *)
	bInCopyCode	: BOOL;
	Name	: Xts_Library.Base_Library.T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO TcIoXtsEnvironmentParameterList.MaxPartsPerTrack DO
	iXtsParts[i] := stubXtsParts[i];
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <Method Name="setEnabled" Id="{626722de-9774-4f59-8220-0e027083d3f9}">
      <Declaration><![CDATA[METHOD setEnabled : BOOL
VAR_INPUT
	Value : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_XtsEnabled := Value;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setHardwareDiscovered" Id="{31efb4cf-7602-4d63-bc28-27635ca47255}">
      <Declaration><![CDATA[METHOD setHardwareDiscovered : HRESULT
VAR_INPUT
	Value : BOOL;
	NumberOFParts : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_HardwareDiscoveryComplete := Value;
MyPartCount := NumberOFParts;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setInitialised" Id="{2528f3aa-d996-4ef3-863b-9b23baf28b1f}">
      <Declaration><![CDATA[METHOD setInitialised : BOOL
VAR_INPUT
	Value : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Initialised := Value;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMoversDetected" Id="{e83e6ebb-002f-42f3-8c18-17622b1b661e}">
      <Declaration><![CDATA[METHOD SetMoversDetected : HRESULT
VAR_INPUT
	Value : BOOL;
	NumberOfMovers : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_MoversDetected := Value;
MyMoverCount := NumberOfMovers;]]></ST>
      </Implementation>
    </Method>
    <Method Name="setXPU" Id="{b9bad0ff-5900-49a4-8078-7e2a57d189f6}">
      <Declaration><![CDATA[METHOD setXPU : HRESULT
VAR_INPUT
	stubXPU : I_TcIoXtsProcessingUnit;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iXPU := stubXPU;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>