<TcPlcObject Version="1.1.0.1">
  <POU Name="XtsCaGroupTestSuite" Id="{136b9f37-13c3-40d8-adf9-d2fba64dd482}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK XtsCaGroupTestSuite
VAR
	ThisTestSuite : TestSuite<TestSuiteParameter.MaxTestCount>(ResultFile := JUnitResultFile) := (TestSuiteName := 'CAGroup Test Suite');
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CAGroupAcceptsMoverRegister_Test();
CAGroupRejectsAddingSameMover_Test();
CAGroupRejectsAddingNullMover_Test();
//CAGroupIncrementsRegisteredMovers_Test();
//CAGroupRejectsAddingMoverWhenBusy_Test();
CAGroupRejectsAddingWhenNotLinkedToCAGroup_Test();

CAGroupAcceptsRemoveAMover_Test();
CAGroupRejectsRemoveNullMover_Test();
CAGroupRejectsRemoveWhenBusy_Test();
CAGroupRejectsRemovingNotGroupedMover_Test();
CAGroupDecrementsRegisteredMovers_Test();

CAGroupAcceptsRemoveAll_Test();
CAGroupRejectsRemoveAllWithNoMovers_Test();
CAGroupRejectsRemoveAllWhenBusy_Test();
CAGroupRemoveAllClearsRegisteredMoverCount_Test();


CAGroupEnableAcceptedWhenNotBusy_Test();
//CAGroupEnableRejectedWhenBusy_Test();
CAGroupDisableAcceptedWhenNotBusy_Test();
//CAGroupDisableRejectedWhenBusy_Test();
CAGroupStopAcceptedWhenNotBusy_Test();
CAGroupStopRejectedWhenBusy_Test();

CAGroupResetAcceptedWhenNotBusy_Test();
CAGroupResetRejectedWhenBusy_Test();]]></ST>
    </Implementation>
    <Method Name="CAGroupAcceptsMoverRegister_Test" Id="{3be7f1bf-7951-4535-b2cf-3c01dcafa27e}">
      <Declaration><![CDATA[METHOD CAGroupAcceptsMoverRegister_Test
VAR_INST
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
END_VAR
VAR
	stubMover : XtsMover('');
	caGroup : CollisionGroup('');
	axisRef : REFERENCE TO AXES_GROUP_REF;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ThisTestSuite.Test(__POUNAME()).ExecuteTest() THEN
	axisRef REF= caGroup.GroupRef;
	axisRef.NcToPlc.Common.GroupType := MC_GROUP_TYPE.mcGroupTypeCA;
	Actual := SUCCEEDED(caGroup.AddMoverToThisGroup(stubMover));
	ThisTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CAGroupAcceptsRemoveAll_Test" Id="{642a5fca-2347-4d08-b497-6dc1508fa5a8}">
      <Declaration><![CDATA[METHOD CAGroupAcceptsRemoveAll_Test : BOOL
