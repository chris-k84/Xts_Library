	axisRef REF= caGroup.GroupRef;
	axisRef.NcToPlc.Common.GroupType := MC_GROUP_TYPE.mcGroupTypeCA;
	caGroup.AddMoverToThisGroup(stubMover);
	Actual := SUCCEEDED(caGroup.RemoveAllMovers());
	ThisTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
