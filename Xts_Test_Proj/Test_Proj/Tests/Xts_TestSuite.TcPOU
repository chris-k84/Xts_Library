<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Xts_TestSuite" Id="{f988a3d2-66dc-4a17-94a6-1c6d0d5b97aa}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Xts_TestSuite
VAR
	testXts : StubXts<1,1,1,1,8>('');
	testXpu : StubXPU;
	ThisTestSuite : TestSuite<TestSuiteParameter.MaxTestCount>(ResultFile := JUnitResultFile) := (TestSuiteName := 'XTS Test Suite');
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CycleRejectsWhenXtsNotDetected();
CycleRejectsWhenXtsNotDiscovered();
CycleRejectsWhenXtsNotInitialised();
XtsAcceptsDisableWhenValid();
XtsAcceptsEnableWhenValid();
XtsAcceptsResetAPartWhenValid();
XtsAcceptsResetWhenValid();
XtsAcceptsTriggerDetectionWhenValid();
XtsRejectsDisableWhenDisabled();
XtsRejectsDisableWhenNotDetected();
XtsRejectsDisableWhenNotDiscovered();
XtsRejectsDisableWhenNotInitialised();
XtsRejectsEnableWhenEnabled();
XtsRejectsEnableWhenNotDetected();
XtsRejectsEnableWhenNotDiscovered();
XtsRejectsEnableWhenNotInitialised();
XtsRejectsResetAPartWhenNotDiscovered();
XtsRejectsResetAPartWhenNotInitialised();
XtsRejectsResetAPartWhenOutOfRange();
XtsRejectsResetAPartWhenZeroIndex();
XtsRejectsResetWhenNotDiscovered();
XtsRejectsResetWhenNotInitialised();
XtsRejectsTriggerDetectionWhenNotDiscovered();
XtsRejectsTriggerDetectionWhenNotInitialised();
XtsRejectsTryGetMoverWhenNotDetected();
XtsRejectsTryGetMoverWhenNotDiscovered();
XtsRejectsTryGetMoverWhenNotInitialised();
XtsRejectsTryGetMoverWhenOutOfRange();
XtsRejectsTryGetMoverWhenZeroIndex();]]></ST>
    </Implementation>
    <Method Name="CycleRejectsWhenXtsNotDetected" Id="{c9476195-0c9f-4a12-8ffb-341842fd6b03}">
      <Declaration><![CDATA[METHOD CycleRejectsWhenXtsNotDetected : BOOL
VAR
	Expected : HRESULT := -3;
	Actual	 : HRESULT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ThisTestSuite.Test(__POUNAME()).ExecuteTest() THEN
	testXts.setInitialised(TRUE);
	testXts.setHardwareDiscovered(TRUE,1);
	testXts.SetMoversDetected(FALSE,1);
	testXts.setEnabled(FALSE);
	testXts.setXPU(testXpu);
	Actual := testXts.Cycle();
	ThisTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
