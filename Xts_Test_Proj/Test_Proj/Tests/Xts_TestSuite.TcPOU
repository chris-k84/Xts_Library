<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Xts_TestSuite" Id="{f988a3d2-66dc-4a17-94a6-1c6d0d5b97aa}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Xts_TestSuite
VAR
	dummyIoEnvVar : XtsInterfaceProvider;
	dummyCaGroup : CollisionGroup;
	//testXts : Xts<1,1,1,1,1>('');
	testXts : StubXts<1,1,1,1,8>('');
	stubMover : XtsMover('');
	stubIMover : I_XtsMover := stubMover;
	stubIMoverEmpty : I_XtsMover;
	ThisTestSuite : TestSuite<TestSuiteParameter.MaxTestCount>(ResultFile := JUnitResultFile) := (TestSuiteName := 'XTS Test Suite');
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[XtsRejectsDisableWhenDisabled_Test();
XtsRejectsEnableWhenEnabled_Test();]]></ST>
    </Implementation>
    <Method Name="XtsRejectsDisableWhenDisabled_Test" Id="{65525f81-11d3-467d-8594-1727392c33c6}">
      <Declaration><![CDATA[METHOD XtsRejectsDisableWhenDisabled_Test
VAR_INST
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ThisTestSuite.Test(__POUNAME()).ExecuteTest() THEN
	testXts.SetDisabled();
	Actual := FAILED(testXts.DisableXTS());
	ThisTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="XtsRejectsEnableWhenEnabled_Test" Id="{0d306c58-1eca-439d-a25b-472acf610587}">
      <Declaration><![CDATA[METHOD XtsRejectsEnableWhenEnabled_Test
VAR_INST
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ThisTestSuite.Test(__POUNAME()).ExecuteTest() THEN
	testXts.setEnabled();
	Actual := FAILED(testXts.EnableXTS());
	ThisTestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>